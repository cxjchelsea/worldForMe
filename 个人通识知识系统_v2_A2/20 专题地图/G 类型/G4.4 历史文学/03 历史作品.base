filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-G44-HISTORICAL")
properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  historical_priority:
    displayName: 专题优先级
  historical_history_cluster:
    displayName: 历史区块
  historical_axes:
    displayName: 历史对象/形式
  read_status:
    displayName: 阅读状态
  axis_t:
    displayName: T 时间
  axis_r:
    displayName: R 地域
  axis_m:
    displayName: M 思潮
  axis_g:
    displayName: G 类型
  axis_n:
    displayName: N 叙事
  axis_q:
    displayName: Q 主题
  id:
    displayName: 稳定 ID
views:
  - type: table
    name: 全部历史作品
    order:
      - file.name
      - author
      - historical_priority
      - historical_history_cluster
      - historical_axes
      - read_status
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - historical_priority == "★"
    order:
      - file.name
      - author
      - historical_history_cluster
      - historical_axes
      - read_status
  - type: table
    name: 骨架未读
    filters:
      and:
        - historical_priority == "★"
        - read_status == "未读"
    order:
      - file.name
      - author
      - historical_history_cluster
      - read_status
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - historical_priority == "◆"
    order:
      - file.name
      - author
      - historical_history_cluster
      - historical_axes
      - read_status
  - type: table
    name: 按历史区块
    groupBy:
      property: historical_history_cluster
      direction: ASC
    order:
      - file.name
      - author
      - historical_priority
      - historical_axes
  - type: table
    name: 横轴已标注
    filters:
      and:
        - "!historical_axes.isEmpty()"
    order:
      - file.name
      - author
      - historical_axes
      - historical_priority
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - historical_priority
      - historical_history_cluster
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - read_status
