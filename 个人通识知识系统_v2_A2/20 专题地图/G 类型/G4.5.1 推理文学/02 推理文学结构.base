filters:
  and:
    - topic_id == "WL-TOPIC-G45-MYSTERY"
properties:
  file.name:
    displayName: 节点
  type:
    displayName: 类型
  dimension:
    displayName: 维度
  sequence:
    displayName: 顺序
  history_cluster:
    displayName: 历史大区块
  parent:
    displayName: 父节点
  id:
    displayName: 稳定 ID
views:
  - type: table
    name: 全部知识节点
    order:
      - file.name
      - dimension
      - sequence
      - history_cluster
      - parent
      - id
  - type: table
    name: 核心结构
    filters:
      and:
        - type == "literature_topic_structure"
        - parent == "WL-TOPIC-G45-MYSTERY"
    order:
      - sequence
      - file.name
      - dimension
      - id
  - type: table
    name: 历史六区块
    filters:
      and:
        - type == "literature_topic_section"
        - parent == "WL-TOPIC-G45-MYSTERY-HISTORY"
    order:
      - sequence
      - file.name
      - history_cluster
      - id
  - type: table
    name: 谜题与结构技法
    filters:
      and:
        - dimension == "technique"
    order:
      - sequence
      - file.name
      - parent
      - id
  - type: table
    name: 犯罪小说模式
    filters:
      and:
        - dimension == "mode"
    order:
      - sequence
      - file.name
      - parent
      - id
  - type: table
    name: 地域传统
    filters:
      and:
        - dimension == "region"
    order:
      - sequence
      - file.name
      - parent
      - id
