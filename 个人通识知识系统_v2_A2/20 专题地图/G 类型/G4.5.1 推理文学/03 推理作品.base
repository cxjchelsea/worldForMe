filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-G45-MYSTERY")
properties:
  file.name:
    displayName: "作品"
  note.author:
    displayName: "作者"
  note.year:
    displayName: "年份"
  note.read_status:
    displayName: "阅读状态"
  note.author_reading_priority:
    displayName: "追读优先级"
  note.topic_links:
    displayName: "专题"
  note.topics:
    displayName: "专题编号"
  note.axis_t:
    displayName: "时间"
  note.axis_r:
    displayName: "地域"
  note.axis_m:
    displayName: "思潮"
  note.axis_g:
    displayName: "类型"
  note.axis_n:
    displayName: "叙事"
  note.axis_q:
    displayName: "主题"
  note.id:
    displayName: "编号"
  note.mystery_priority:
    displayName: "优先级"
  note.mystery_history_cluster:
    displayName: "历史位置"
  note.verification_status:
    displayName: "校验状态"
  note.mystery_history:
    displayName: "细部历史"
  note.mystery_history_detail:
    displayName: "历史细分"
  note.mystery_technique:
    displayName: "谜题技法"
  note.mystery_mode:
    displayName: "犯罪模式"
views:
  - type: table
    name: 全部推理作品
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - mystery_priority
      - mystery_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - mystery_priority == "★"
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - mystery_priority
      - mystery_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 骨架未读
    filters:
      and:
        - mystery_priority == "★"
        - read_status == "未读"
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - mystery_priority
      - mystery_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - mystery_priority == "◆"
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - mystery_priority
      - mystery_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 深挖候选 ○
    filters:
      and:
        - mystery_priority == "○"
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - mystery_priority
      - mystery_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 历史 前史与黄金时代
    filters:
      and:
        - mystery_history_cluster.contains("前史、侦探诞生与黄金时代")
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - mystery_priority
      - mystery_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 历史 英美类型扩张
    filters:
      and:
        - mystery_history_cluster.contains("英美犯罪小说传统与类型扩张")
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - mystery_priority
      - mystery_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 历史 日本推理
    filters:
      and:
        - mystery_history_cluster.contains("日本推理传统")
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - mystery_priority
      - mystery_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 历史 北欧与欧洲大陆
    filters:
      and:
        - mystery_history_cluster.contains("北欧与欧洲大陆犯罪文学")
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - mystery_priority
      - mystery_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 历史 中文推理
    filters:
      and:
        - mystery_history_cluster.contains("中文推理")
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - mystery_priority
      - mystery_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 历史 边界类型
    filters:
      and:
        - mystery_history_cluster.contains("边界类型")
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - mystery_priority
      - mystery_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 技法 已明确标注
    filters:
      and:
        - "!mystery_technique.isEmpty()"
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - mystery_priority
      - mystery_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 模式 已明确标注
    filters:
      and:
        - "!mystery_mode.isEmpty()"
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - mystery_priority
      - mystery_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - mystery_priority
      - mystery_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 需复核
    filters:
      and:
        - verification_status == "需复核"
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - mystery_priority
      - mystery_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - mystery_priority
      - mystery_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
