filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-G43-BILDUNGSROMAN")
properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  growth_priority:
    displayName: 专题优先级
  growth_history_cluster:
    displayName: 历史区块
  growth_axes:
    displayName: 成长机制
  read_status:
    displayName: 阅读状态
  axis_t:
    displayName: T 时间
  axis_r:
    displayName: R 地域
  axis_m:
    displayName: M 思潮
  axis_g:
    displayName: G 类型
  axis_n:
    displayName: N 叙事
  axis_q:
    displayName: Q 主题
  id:
    displayName: 稳定 ID
views:
  - type: table
    name: 全部成长作品
    order:
      - file.name
      - author
      - growth_priority
      - growth_history_cluster
      - growth_axes
      - read_status
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - growth_priority == "★"
    order:
      - file.name
      - author
      - growth_history_cluster
      - growth_axes
      - read_status
  - type: table
    name: 骨架未读
    filters:
      and:
        - growth_priority == "★"
        - read_status == "未读"
    order:
      - file.name
      - author
      - growth_history_cluster
      - read_status
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - growth_priority == "◆"
    order:
      - file.name
      - author
      - growth_history_cluster
      - growth_axes
      - read_status
  - type: table
    name: 按历史区块
    groupBy:
      property: growth_history_cluster
      direction: ASC
    order:
      - file.name
      - author
      - growth_priority
      - growth_axes
  - type: table
    name: 横轴已标注
    filters:
      and:
        - "!growth_axes.isEmpty()"
    order:
      - file.name
      - author
      - growth_axes
      - growth_priority
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - growth_priority
      - growth_history_cluster
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - read_status
