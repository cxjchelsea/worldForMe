filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-G43-BILDUNGSROMAN")
properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  growth_priority:
    displayName: 专题优先级
  growth_history_cluster:
    displayName: 历史区块
  growth_axes:
    displayName: 成长机制
  read_status:
    displayName: 阅读状态
  id:
    displayName: 稳定 ID
views:
  - type: table
    name: 全部成长作品
    order:
      - file.name
      - author
      - growth_priority
      - growth_history_cluster
      - growth_axes
      - read_status
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - growth_priority == "★"
    order:
      - file.name
      - author
      - growth_history_cluster
      - growth_axes
      - read_status
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - growth_priority == "◆"
    order:
      - file.name
      - author
      - growth_history_cluster
      - growth_axes
      - read_status
  - type: table
    name: 按历史区块
    groupBy:
      property: growth_history_cluster
      direction: ASC
    order:
      - file.name
      - author
      - growth_priority
      - growth_axes
  - type: table
    name: 横轴已标注
    filters:
      and:
        - "!growth_axes.isEmpty()"
    order:
      - file.name
      - author
      - growth_axes
      - growth_priority
  - type: table
    name: 阅读状态未映射
    filters:
      and:
        - read_status == "未映射"
    order:
      - file.name
      - author
      - growth_priority
      - growth_history_cluster
