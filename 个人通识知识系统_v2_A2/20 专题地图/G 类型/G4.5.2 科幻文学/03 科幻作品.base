filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-G45-SF")
properties:
  file.name:
    displayName: "作品"
  note.author:
    displayName: "作者"
  note.read_status:
    displayName: "阅读状态"
  note.topic_links:
    displayName: "专题"
  note.topics:
    displayName: "专题编号"
  note.axis_t:
    displayName: "时间"
  note.axis_r:
    displayName: "地域"
  note.axis_m:
    displayName: "思潮"
  note.axis_g:
    displayName: "类型"
  note.axis_n:
    displayName: "叙事"
  note.axis_q:
    displayName: "主题"
  note.id:
    displayName: "编号"
  note.sf_priority:
    displayName: "优先级"
  note.sf_history_cluster:
    displayName: "历史位置"
  note.sf_themes:
    displayName: "机制"
  note.verification_status:
    displayName: "校验状态"
  note.sf_history:
    displayName: "细部历史"
  note.sf_region:
    displayName: "地域标签"
views:
  - type: table
    name: 全部作品
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - sf_priority
      - sf_history_cluster
      - sf_themes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - sf_priority == "★"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - sf_priority
      - sf_history_cluster
      - sf_themes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 骨架未读
    filters:
      and:
        - sf_priority == "★"
        - read_status == "未读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - sf_priority
      - sf_history_cluster
      - sf_themes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - sf_priority == "◆"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - sf_priority
      - sf_history_cluster
      - sf_themes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 按历史
    groupBy:
      property: sf_history_cluster
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - sf_priority
      - sf_history_cluster
      - sf_themes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: AI与机器人
    filters:
      and:
        - sf_themes.contains("AI / 机器人")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - sf_priority
      - sf_history_cluster
      - sf_themes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 第一接触
    filters:
      and:
        - sf_themes.contains("第一接触")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - sf_priority
      - sf_history_cluster
      - sf_themes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 时间旅行
    filters:
      and:
        - sf_themes.contains("时间旅行")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - sf_priority
      - sf_history_cluster
      - sf_themes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 反乌托邦
    filters:
      and:
        - sf_themes.contains("反乌托邦")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - sf_priority
      - sf_history_cluster
      - sf_themes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 硬科幻
    filters:
      and:
        - sf_themes.contains("Hard SF")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - sf_priority
      - sf_history_cluster
      - sf_themes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 赛博朋克
    filters:
      and:
        - sf_themes.contains("Cyberpunk")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - sf_priority
      - sf_history_cluster
      - sf_themes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 太空歌剧
    filters:
      and:
        - sf_themes.contains("太空歌剧")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - sf_priority
      - sf_history_cluster
      - sf_themes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 军事科幻
    filters:
      and:
        - sf_themes.contains("军事科幻")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - sf_priority
      - sf_history_cluster
      - sf_themes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 社会／人类学科幻
    filters:
      and:
        - sf_themes.contains("社会科学 / 人类学科幻")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - sf_priority
      - sf_history_cluster
      - sf_themes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 后人类
    filters:
      and:
        - sf_themes.contains("后人类")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - sf_priority
      - sf_history_cluster
      - sf_themes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 生态与气候小说
    filters:
      and:
        - sf_themes.contains("生态 / Climate Fiction")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - sf_priority
      - sf_history_cluster
      - sf_themes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - sf_priority
      - sf_history_cluster
      - sf_themes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - sf_priority
      - sf_history_cluster
      - sf_themes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
