filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-G43-FAMILY")
properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  family_priority:
    displayName: 专题优先级
  family_history_cluster:
    displayName: 历史区块
  family_axes:
    displayName: 家族机制
  read_status:
    displayName: 阅读状态
  id:
    displayName: 稳定 ID
views:
  - type: table
    name: 全部家族作品
    order:
      - file.name
      - author
      - family_priority
      - family_history_cluster
      - family_axes
      - read_status
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - family_priority == "★"
    order:
      - file.name
      - author
      - family_history_cluster
      - family_axes
      - read_status
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - family_priority == "◆"
    order:
      - file.name
      - author
      - family_history_cluster
      - family_axes
      - read_status
  - type: table
    name: 按历史区块
    groupBy:
      property: family_history_cluster
      direction: ASC
    order:
      - file.name
      - author
      - family_priority
      - family_axes
  - type: table
    name: 横轴已标注
    filters:
      and:
        - "!family_axes.isEmpty()"
    order:
      - file.name
      - author
      - family_axes
      - family_priority
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - family_priority
      - family_history_cluster
