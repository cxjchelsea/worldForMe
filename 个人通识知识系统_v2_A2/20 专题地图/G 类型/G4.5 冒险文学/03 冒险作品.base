filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-G45-ADVENTURE")
properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  adventure_priority:
    displayName: 冒险优先级
  adventure_history_cluster:
    displayName: 历史区块
  adventure_axes:
    displayName: 冒险结构横轴
  read_status:
    displayName: 阅读状态
  axis_t:
    displayName: T 时间
  axis_r:
    displayName: R 地域
  axis_m:
    displayName: M 思潮
  axis_g:
    displayName: G 类型
  axis_n:
    displayName: N 叙事
  axis_q:
    displayName: Q 主题
  id:
    displayName: 稳定 ID
views:
  - type: table
    name: 全部冒险作品
    order:
      - file.name
      - author
      - adventure_priority
      - adventure_history_cluster
      - adventure_axes
      - read_status
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - adventure_priority == "★"
    order:
      - file.name
      - author
      - adventure_history_cluster
      - adventure_axes
      - read_status
  - type: table
    name: 骨架未读
    filters:
      and:
        - adventure_priority == "★"
        - read_status == "未读"
    order:
      - file.name
      - author
      - adventure_history_cluster
      - read_status
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - adventure_priority == "◆"
    order:
      - file.name
      - author
      - adventure_history_cluster
      - adventure_axes
      - read_status
  - type: table
    name: 边界 △
    filters:
      and:
        - adventure_priority == "△"
    order:
      - file.name
      - author
      - adventure_history_cluster
      - adventure_axes
      - read_status
  - type: table
    name: 按历史区块
    groupBy:
      property: adventure_history_cluster
      direction: ASC
    order:
      - file.name
      - author
      - adventure_priority
      - adventure_axes
  - type: table
    name: 横轴已标注
    filters:
      and:
        - "!adventure_axes.isEmpty()"
    order:
      - file.name
      - author
      - adventure_axes
      - adventure_priority
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - read_status
