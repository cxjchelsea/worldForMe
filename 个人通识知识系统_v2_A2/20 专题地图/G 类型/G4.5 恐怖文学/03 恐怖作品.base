filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-G45-HORROR")
properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  horror_priority:
    displayName: 恐怖优先级
  horror_history_cluster:
    displayName: 历史区块
  horror_subgenres:
    displayName: 恐惧机制/子类型
  horror_region:
    displayName: 地域入口
  read_status:
    displayName: 阅读状态
  axis_t:
    displayName: T 时间
  axis_r:
    displayName: R 地域
  axis_m:
    displayName: M 思潮
  axis_g:
    displayName: G 类型
  axis_n:
    displayName: N 叙事
  axis_q:
    displayName: Q 主题
  id:
    displayName: 稳定 ID
views:
  - type: table
    name: 全部恐怖作品
    order:
      - file.name
      - author
      - horror_priority
      - horror_history_cluster
      - horror_subgenres
      - horror_region
      - read_status
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - horror_priority == "★"
    order:
      - file.name
      - author
      - horror_history_cluster
      - horror_subgenres
      - read_status
  - type: table
    name: 骨架未读
    filters:
      and:
        - horror_priority == "★"
        - read_status == "未读"
    order:
      - file.name
      - author
      - horror_history_cluster
      - read_status
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - horror_priority == "◆"
    order:
      - file.name
      - author
      - horror_history_cluster
      - horror_subgenres
      - read_status
  - type: table
    name: 按历史区块
    groupBy:
      property: horror_history_cluster
      direction: ASC
    order:
      - file.name
      - author
      - horror_priority
      - horror_subgenres
  - type: table
    name: 子类型已标注
    filters:
      and:
        - "!horror_subgenres.isEmpty()"
    order:
      - file.name
      - author
      - horror_subgenres
      - horror_priority
  - type: table
    name: 地域已标注
    filters:
      and:
        - "!horror_region.isEmpty()"
    order:
      - file.name
      - author
      - horror_region
      - horror_priority
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - read_status
