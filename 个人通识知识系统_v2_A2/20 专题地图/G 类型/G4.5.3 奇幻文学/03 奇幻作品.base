filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-G45-FANTASY")
properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  fantasy_priority:
    displayName: 奇幻优先级
  fantasy_history_cluster:
    displayName: 历史区块
  fantasy_subgenres:
    displayName: 子类型
  fantasy_region:
    displayName: 地域入口
  read_status:
    displayName: 阅读状态
  axis_t:
    displayName: T 时间
  axis_r:
    displayName: R 地域
  axis_m:
    displayName: M 思潮
  axis_g:
    displayName: G 类型
  axis_n:
    displayName: N 叙事
  axis_q:
    displayName: Q 主题
  id:
    displayName: 稳定 ID
views:
  - type: table
    name: 全部奇幻作品
    order:
      - file.name
      - author
      - fantasy_priority
      - fantasy_history_cluster
      - fantasy_subgenres
      - fantasy_region
      - read_status
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - fantasy_priority == "★"
    order:
      - file.name
      - author
      - fantasy_history_cluster
      - fantasy_subgenres
      - read_status
  - type: table
    name: 骨架未读
    filters:
      and:
        - fantasy_priority == "★"
        - read_status == "未读"
    order:
      - file.name
      - author
      - fantasy_history_cluster
      - read_status
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - fantasy_priority == "◆"
    order:
      - file.name
      - author
      - fantasy_history_cluster
      - fantasy_subgenres
      - read_status
  - type: table
    name: 边界 △
    filters:
      and:
        - fantasy_priority == "△"
    order:
      - file.name
      - author
      - fantasy_history_cluster
      - read_status
  - type: table
    name: 按历史区块
    groupBy:
      property: fantasy_history_cluster
      direction: ASC
    order:
      - file.name
      - author
      - fantasy_priority
      - fantasy_subgenres
  - type: table
    name: 子类型已标注
    filters:
      and:
        - "!fantasy_subgenres.isEmpty()"
    order:
      - file.name
      - author
      - fantasy_subgenres
      - fantasy_priority
  - type: table
    name: 地域已标注
    filters:
      and:
        - "!fantasy_region.isEmpty()"
    order:
      - file.name
      - author
      - fantasy_region
      - fantasy_priority
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - read_status
