filters:
  and:
    - 'topic_id == "WL-TOPIC-Q2-LOVE"'
properties:
  file.name:
    displayName: 节点
  type:
    displayName: 类型
  dimension:
    displayName: 维度
  sequence:
    displayName: 顺序
  love_history_stage:
    displayName: 历史阶段
  id:
    displayName: 稳定 ID
views:
  - type: table
    name: 全部知识节点
    order: [file.name, type, dimension, sequence, love_history_stage, id]
  - type: table
    name: 核心结构
    filters:
      and:
        - 'type == "literature_topic_structure"'
    order: [file.name, dimension, id]
  - type: table
    name: 九个历史阶段
    filters:
      and:
        - 'type == "literature_topic_section"'
    order: [sequence, file.name, love_history_stage]
  - type: table
    name: 类型机制深化
    filters:
      and:
        - 'type == "literature_topic_mechanism"'
    order: [file.name, dimension, id]
