filters:
  and:
    - 'topic_id == "WL-TOPIC-Q10-MEMORY"'

properties:
  file.name:
    displayName: 节点
  type:
    displayName: 类型
  dimension:
    displayName: 维度
  sequence:
    displayName: 顺序
  parent:
    displayName: 父节点
  memory_dimension:
    displayName: 记忆维度
  id:
    displayName: 稳定 ID

views:
  - type: table
    name: 全部知识节点
    order:
      - file.name
      - type
      - dimension
      - sequence
      - parent
      - memory_dimension
      - id

  - type: table
    name: 核心结构
    filters:
      and:
        - 'type == "literature_topic_structure"'
    order:
      - file.name
      - dimension
      - id

  - type: table
    name: 八个记忆问题
    filters:
      and:
        - 'type == "literature_topic_section"'
        - 'parent == "WL-TOPIC-Q10-MEMORY-DIMENSIONS"'
    order:
      - sequence
      - file.name
      - memory_dimension
      - id

  - type: table
    name: 记忆机制深化
    filters:
      and:
        - 'type == "literature_topic_mechanism"'
    order:
      - sequence
      - file.name
      - dimension
      - parent
      - id
