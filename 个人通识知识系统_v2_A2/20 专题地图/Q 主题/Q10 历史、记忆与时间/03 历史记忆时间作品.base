filters:
  and:
    - 'type == "work"'
    - 'topics.contains("WL-TOPIC-Q10-MEMORY")'

properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  memory_priority:
    displayName: Q10优先级
  memory_dimensions:
    displayName: 记忆/时间维度
  read_status:
    displayName: 阅读状态
  id:
    displayName: 稳定 ID

views:
  - type: table
    name: 全部Q10作品
    order:
      - file.name
      - author
      - memory_priority
      - memory_dimensions
      - read_status
  - type: table
    name: 个人记忆
    filters:
      and:
        - 'memory_dimensions.contains("个人记忆")'
    order:
      - file.name
      - author
      - memory_priority
      - read_status
  - type: table
    name: 家族记忆
    filters:
      and:
        - 'memory_dimensions.contains("家族记忆")'
    order:
      - file.name
      - author
      - memory_priority
      - read_status
  - type: table
    name: 集体记忆
    filters:
      and:
        - 'memory_dimensions.contains("集体记忆")'
    order:
      - file.name
      - author
      - memory_priority
      - read_status
  - type: table
    name: 历史创伤
    filters:
      and:
        - 'memory_dimensions.contains("历史创伤")'
    order:
      - file.name
      - author
      - memory_priority
      - read_status
  - type: table
    name: 遗忘
    filters:
      and:
        - 'memory_dimensions.contains("遗忘")'
    order:
      - file.name
      - author
      - memory_priority
      - read_status
  - type: table
    name: 历史重写
    filters:
      and:
        - 'memory_dimensions.contains("历史重写")'
    order:
      - file.name
      - author
      - memory_priority
      - read_status
  - type: table
    name: 代际记忆
    filters:
      and:
        - 'memory_dimensions.contains("代际记忆")'
    order:
      - file.name
      - author
      - memory_priority
      - read_status
  - type: table
    name: 时间
    filters:
      and:
        - 'memory_dimensions.contains("时间")'
    order:
      - file.name
      - author
      - memory_priority
      - read_status
