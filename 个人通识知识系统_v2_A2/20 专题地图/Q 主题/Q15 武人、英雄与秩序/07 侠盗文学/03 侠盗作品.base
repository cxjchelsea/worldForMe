filters:
  and:
    - 'type == "work"'
    - 'topics.contains("WL-TOPIC-Q15-OUTLAW")'

properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  outlaw_priority:
    displayName: 专题优先级
  outlaw_tradition_cluster:
    displayName: 地域／角色系统
  outlaw_axes:
    displayName: 内部横轴
  martial_systems:
    displayName: Q15系统
  read_status:
    displayName: 阅读状态
  axis_t:
    displayName: T 时间
  axis_r:
    displayName: R 地域
  axis_m:
    displayName: M 思潮
  axis_g:
    displayName: G 类型
  axis_n:
    displayName: N 叙事
  axis_q:
    displayName: Q 主题
  id:
    displayName: 稳定 ID

views:
  - type: table
    name: 全部侠盗作品
    order:
      - file.name
      - author
      - outlaw_priority
      - outlaw_tradition_cluster
      - outlaw_axes
      - read_status
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - 'outlaw_priority == "★"'
    order:
      - file.name
      - author
      - outlaw_tradition_cluster
      - outlaw_axes
      - read_status
  - type: table
    name: 骨架未读
    filters:
      and:
        - 'outlaw_priority == "★"'
        - 'read_status == "未读"'
    order:
      - file.name
      - author
      - outlaw_tradition_cluster
      - read_status
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - 'outlaw_priority == "◆"'
    order:
      - file.name
      - author
      - outlaw_tradition_cluster
      - outlaw_axes
      - read_status
  - type: table
    name: 按地域／角色系统
    groupBy:
      property: outlaw_tradition_cluster
      direction: ASC
    order:
      - file.name
      - author
      - outlaw_priority
      - outlaw_axes
  - type: table
    name: 横轴已标注
    filters:
      and:
        - '!outlaw_axes.isEmpty()'
    order:
      - file.name
      - author
      - outlaw_axes
      - outlaw_tradition_cluster
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - read_status
