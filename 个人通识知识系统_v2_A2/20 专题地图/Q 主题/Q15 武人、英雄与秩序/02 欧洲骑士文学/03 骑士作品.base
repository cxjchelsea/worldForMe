filters:
  and:
    - 'type == "work"'
    - 'topics.contains("WL-TOPIC-Q15-KNIGHT")'

properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  knight_priority:
    displayName: 专题优先级
  knight_history_stage:
    displayName: 历史阶段
  knight_axes:
    displayName: 内部横轴
  martial_systems:
    displayName: Q15系统
  read_status:
    displayName: 阅读状态
  axis_t:
    displayName: T 时间
  axis_r:
    displayName: R 地域
  axis_m:
    displayName: M 思潮
  axis_g:
    displayName: G 类型
  axis_n:
    displayName: N 叙事
  axis_q:
    displayName: Q 主题
  id:
    displayName: 稳定 ID

views:
  - type: table
    name: 全部骑士作品
    order:
      - file.name
      - author
      - knight_priority
      - knight_history_stage
      - knight_axes
      - read_status
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - 'knight_priority == "★"'
    order:
      - file.name
      - author
      - knight_history_stage
      - knight_axes
      - read_status
  - type: table
    name: 骨架未读
    filters:
      and:
        - 'knight_priority == "★"'
        - 'read_status == "未读"'
    order:
      - file.name
      - author
      - knight_history_stage
      - read_status
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - 'knight_priority == "◆"'
    order:
      - file.name
      - author
      - knight_history_stage
      - knight_axes
      - read_status
  - type: table
    name: 按历史阶段
    groupBy:
      property: knight_history_stage
      direction: ASC
    order:
      - file.name
      - author
      - knight_priority
      - knight_axes
  - type: table
    name: 横轴已标注
    filters:
      and:
        - '!knight_axes.isEmpty()'
    order:
      - file.name
      - author
      - knight_axes
      - knight_history_stage
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - read_status
