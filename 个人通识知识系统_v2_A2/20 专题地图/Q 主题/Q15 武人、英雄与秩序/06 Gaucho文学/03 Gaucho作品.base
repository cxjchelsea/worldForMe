filters:
  and:
    - 'type == "work"'
    - 'topics.contains("WL-TOPIC-Q15-GAUCHO")'

properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  gaucho_priority:
    displayName: 专题优先级
  gaucho_history_stage:
    displayName: 历史阶段
  gaucho_axes:
    displayName: 内部横轴
  martial_systems:
    displayName: Q15系统
  read_status:
    displayName: 阅读状态
  id:
    displayName: 稳定 ID

views:
  - type: table
    name: 全部Gaucho作品
    order:
      - file.name
      - author
      - gaucho_priority
      - gaucho_history_stage
      - gaucho_axes
      - read_status
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - 'gaucho_priority == "★"'
    order:
      - file.name
      - author
      - gaucho_history_stage
      - gaucho_axes
      - read_status
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - 'gaucho_priority == "◆"'
    order:
      - file.name
      - author
      - gaucho_history_stage
      - gaucho_axes
      - read_status
  - type: table
    name: 按历史阶段
    groupBy:
      property: gaucho_history_stage
      direction: ASC
    order:
      - file.name
      - author
      - gaucho_priority
      - gaucho_axes
  - type: table
    name: 横轴已标注
    filters:
      and:
        - '!gaucho_axes.isEmpty()'
    order:
      - file.name
      - author
      - gaucho_axes
      - gaucho_history_stage
