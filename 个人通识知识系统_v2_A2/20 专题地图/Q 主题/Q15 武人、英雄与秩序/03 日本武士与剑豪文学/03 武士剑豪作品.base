filters:
  and:
    - 'type == "work"'
    - 'topics.contains("WL-TOPIC-Q15-SAMURAI")'

properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  samurai_priority:
    displayName: 专题优先级
  samurai_history_stage:
    displayName: 历史阶段
  samurai_axes:
    displayName: 内部横轴
  martial_systems:
    displayName: Q15系统
  read_status:
    displayName: 阅读状态
  id:
    displayName: 稳定 ID

views:
  - type: table
    name: 全部武士剑豪作品
    order:
      - file.name
      - author
      - samurai_priority
      - samurai_history_stage
      - samurai_axes
      - read_status
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - 'samurai_priority == "★"'
    order:
      - file.name
      - author
      - samurai_history_stage
      - samurai_axes
      - read_status
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - 'samurai_priority == "◆"'
    order:
      - file.name
      - author
      - samurai_history_stage
      - samurai_axes
      - read_status
  - type: table
    name: 按历史阶段
    groupBy:
      property: samurai_history_stage
      direction: ASC
    order:
      - file.name
      - author
      - samurai_priority
      - samurai_axes
  - type: table
    name: 横轴已标注
    filters:
      and:
        - '!samurai_axes.isEmpty()'
    order:
      - file.name
      - author
      - samurai_axes
      - samurai_history_stage
