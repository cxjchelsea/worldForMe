filters:
  and:
    - 'type == "work"'
    - 'topics.contains("WL-TOPIC-Q15")'

properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  martial_systems:
    displayName: 武人系统
  q15_core_compare:
    displayName: 总谱系核心
  read_status:
    displayName: 阅读状态
  id:
    displayName: 稳定 ID

views:
  - type: table
    name: 全部Q15作品
    order:
      - file.name
      - author
      - martial_systems
      - q15_core_compare
      - read_status

  - type: table
    name: 总谱系跨文明对读核心
    filters:
      and:
        - 'q15_core_compare == true'
    order:
      - file.name
      - author
      - martial_systems
  - type: table
    name: 武侠
    filters:
      and:
        - 'martial_systems.contains("武侠")'
    order:
      - file.name
      - author
      - read_status
  - type: table
    name: 欧洲骑士
    filters:
      and:
        - 'martial_systems.contains("欧洲骑士")'
    order:
      - file.name
      - author
      - read_status
  - type: table
    name: 日本武士／剑豪
    filters:
      and:
        - 'martial_systems.contains("日本武士／剑豪")'
    order:
      - file.name
      - author
      - read_status
  - type: table
    name: 欧洲剑客／Swashbuckler
    filters:
      and:
        - 'martial_systems.contains("欧洲剑客／Swashbuckler")'
    order:
      - file.name
      - author
      - read_status
  - type: table
    name: 西部／Western
    filters:
      and:
        - 'martial_systems.contains("西部／Western")'
    order:
      - file.name
      - author
      - read_status
  - type: table
    name: Gaucho
    filters:
      and:
        - 'martial_systems.contains("Gaucho")'
    order:
      - file.name
      - author
      - read_status
  - type: table
    name: 侠盗／Outlaw Hero
    filters:
      and:
        - 'martial_systems.contains("侠盗／Outlaw Hero")'
    order:
      - file.name
      - author
      - read_status
  - type: table
    name: 海盗／Maritime Outlaw
    filters:
      and:
        - 'martial_systems.contains("海盗／Maritime Outlaw")'
    order:
      - file.name
      - author
      - read_status
