filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-Q15")
properties:
  file.name:
    displayName: "作品"
  note.author:
    displayName: "作者"
  note.read_status:
    displayName: "阅读状态"
  note.topic_links:
    displayName: "专题"
  note.topics:
    displayName: "专题编号"
  note.axis_t:
    displayName: "时间"
  note.axis_r:
    displayName: "地域"
  note.axis_m:
    displayName: "思潮"
  note.axis_g:
    displayName: "类型"
  note.axis_n:
    displayName: "叙事"
  note.axis_q:
    displayName: "主题"
  note.id:
    displayName: "编号"
  note.martial_systems:
    displayName: "武人系统"
  note.q15_core_compare:
    displayName: "总谱系核心"
views:
  - type: table
    name: 全部作品
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - martial_systems
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 骨架未读
    filters:
      and:
        - q15_core_compare == true
        - read_status == "未读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - martial_systems
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 按武人系统
    groupBy:
      property: martial_systems
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - martial_systems
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 总谱系跨文明对读核心
    filters:
      and:
        - q15_core_compare == true
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - martial_systems
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 武侠
    filters:
      and:
        - martial_systems.contains("武侠")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - martial_systems
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 欧洲骑士
    filters:
      and:
        - martial_systems.contains("欧洲骑士")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - martial_systems
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 日本武士／剑豪
    filters:
      and:
        - martial_systems.contains("日本武士／剑豪")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - martial_systems
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 欧洲剑客
    filters:
      and:
        - martial_systems.contains("欧洲剑客／Swashbuckler")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - martial_systems
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 西部
    filters:
      and:
        - martial_systems.contains("西部／Western")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - martial_systems
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: Gaucho
    filters:
      and:
        - martial_systems.contains("Gaucho")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - martial_systems
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 侠盗
    filters:
      and:
        - martial_systems.contains("侠盗／Outlaw Hero")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - martial_systems
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 海盗
    filters:
      and:
        - martial_systems.contains("海盗／Maritime Outlaw")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - martial_systems
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - martial_systems
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - martial_systems
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
