filters:
  and:
    - 'topic_id == "WL-TOPIC-Q15"'

properties:
  file.name:
    displayName: 节点
  type:
    displayName: 类型
  dimension:
    displayName: 维度
  sequence:
    displayName: 顺序
  system_name:
    displayName: 武人系统
  id:
    displayName: 稳定 ID

views:
  - type: table
    name: 全部Q15知识节点
    order: [file.name, dimension, sequence, system_name, id]
  - type: table
    name: 核心结构
    filters:
      and:
        - 'type == "literature_topic_structure"'
    order: [file.name, dimension, id]
  - type: table
    name: 八个系统
    filters:
      and:
        - 'type == "literature_topic_section"'
    order: [sequence, file.name, system_name]
