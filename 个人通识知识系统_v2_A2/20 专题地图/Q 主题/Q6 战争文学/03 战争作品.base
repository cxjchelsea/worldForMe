filters:
  and:
    - 'type == "work"'
    - 'topics.contains("WL-TOPIC-Q6-WAR")'

properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  war_priority:
    displayName: 战争优先级
  war_history_stage:
    displayName: 历史阶段
  war_axes:
    displayName: 战争横轴
  read_status:
    displayName: 阅读状态
  axis_t:
    displayName: T 时间
  axis_r:
    displayName: R 地域
  axis_m:
    displayName: M 思潮
  axis_g:
    displayName: G 类型
  axis_n:
    displayName: N 叙事
  axis_q:
    displayName: Q 主题
  id:
    displayName: 稳定 ID

views:
  - type: table
    name: 全部战争作品
    order: [file.name, author, war_priority, war_history_stage, war_axes, read_status]
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - 'war_priority == "★"'
    order: [file.name, author, war_history_stage, war_axes, read_status]
  - type: table
    name: 骨架未读
    filters:
      and:
        - 'war_priority == "★"'
        - 'read_status == "未读"'
    order: [file.name, author, war_history_stage, read_status]
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - 'war_priority == "◆"'
    order: [file.name, author, war_history_stage, war_axes, read_status]
  - type: table
    name: 边界 △
    filters:
      and:
        - 'war_priority == "△"'
    order: [file.name, author, war_history_stage, war_axes, read_status]
  - type: table
    name: 按历史阶段
    groupBy:
      property: war_history_stage
      direction: ASC
    order: [file.name, author, war_priority, war_axes]
  - type: table
    name: 横轴已标注
    filters:
      and:
        - '!war_axes.isEmpty()'
    order: [file.name, author, war_axes, war_history_stage]

  - type: table
    name: 问题 战斗与士兵
    filters:
      and:
        - or:
            - 'war_axes.contains("英雄主义")'
            - 'war_axes.contains("普通士兵")'
            - 'war_axes.contains("反战")'
            - 'war_axes.contains("荒诞")'
            - 'war_axes.contains("军事制度")'
            - 'war_axes.contains("战俘")'
    order: [file.name, author, war_axes, war_history_stage, war_priority, read_status]
  - type: table
    name: 问题 平民与占领
    filters:
      and:
        - or:
            - 'war_axes.contains("平民")'
            - 'war_axes.contains("占领")'
            - 'war_axes.contains("女性")'
            - 'war_axes.contains("儿童")'
            - 'war_axes.contains("战争与爱情")'
    order: [file.name, author, war_axes, war_history_stage, war_priority, read_status]
  - type: table
    name: 问题 灭绝与核暴力
    filters:
      and:
        - or:
            - 'war_axes.contains("Holocaust/Genocide")'
            - 'war_axes.contains("轰炸与核战争")'
    order: [file.name, author, war_axes, war_history_stage, war_priority, read_status]
  - type: table
    name: 问题 内战与殖民战争
    filters:
      and:
        - or:
            - 'war_axes.contains("内战")'
            - 'war_axes.contains("殖民战争")'
    order: [file.name, author, war_axes, war_history_stage, war_priority, read_status]
  - type: table
    name: 问题 创伤与记忆
    filters:
      and:
        - or:
            - 'war_axes.contains("创伤/Afterwar")'
            - 'war_axes.contains("战争记忆")'
    order: [file.name, author, war_axes, war_history_stage, war_priority, read_status]
  - type: table
    name: 问题 真相与责任
    filters:
      and:
        - or:
            - 'war_axes.contains("战争真相与叙事")'
            - 'war_axes.contains("加害者/Complicity")'
            - 'war_axes.contains("战争×类型融合")'
    order: [file.name, author, war_axes, war_history_stage, war_priority, read_status]

  - type: table
    name: 未读
    filters:
      and:
        - 'read_status == "未读"'
    order: [file.name, author, war_priority, war_history_stage, read_status]
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - read_status
