filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-R6-LATAM")
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.year:
    displayName: 年份
  note.read_status:
    displayName: 阅读状态
  note.author_reading_priority:
    displayName: 追读优先级
  note.topic_links:
    displayName: 专题
  note.topics:
    displayName: 专题编号
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 类型
  note.axis_n:
    displayName: 叙事
  note.axis_q:
    displayName: 主题
  note.id:
    displayName: 编号
  note.latam_priority:
    displayName: 优先级
  note.latam_history_stage:
    displayName: 历史位置
  note.latam_axes:
    displayName: 机制
views:
  - type: table
    name: 全部作品
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - latam_priority
      - latam_history_stage
      - latam_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - latam_priority == "★"
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - latam_priority
      - latam_history_stage
      - latam_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 骨架未读
    filters:
      and:
        - latam_priority == "★"
        - read_status == "未读"
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - latam_priority
      - latam_history_stage
      - latam_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - latam_priority == "◆"
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - latam_priority
      - latam_history_stage
      - latam_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 按历史
    groupBy:
      property: latam_history_stage
      direction: ASC
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - latam_priority
      - latam_history_stage
      - latam_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - latam_priority
      - latam_history_stage
      - latam_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - year
      - read_status
      - author_reading_priority
      - topic_links
      - latam_priority
      - latam_history_stage
      - latam_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
