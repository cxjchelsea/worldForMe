filters:
  and:
    - 'topic_id == "WL-TOPIC-T5-POSTWAR"'

properties:
  file.name:
    displayName: 节点
  type:
    displayName: 类型
  dimension:
    displayName: 维度
  sequence:
    displayName: 顺序
  parent:
    displayName: 父节点
  postwar_stage:
    displayName: 时间阶段
  id:
    displayName: 稳定 ID

views:
  - type: table
    name: 全部知识节点
    order:
      - file.name
      - type
      - dimension
      - sequence
      - parent
      - postwar_stage
      - id

  - type: table
    name: 核心结构
    filters:
      and:
        - 'type == "literature_topic_structure"'
    order:
      - file.name
      - dimension
      - id

  - type: table
    name: 四个时间阶段
    filters:
      and:
        - 'type == "literature_topic_section"'
        - 'parent == "WL-TOPIC-T5-POSTWAR-HISTORY"'
    order:
      - sequence
      - file.name
      - postwar_stage
      - id

  - type: table
    name: 战后机制深化
    filters:
      and:
        - 'type == "literature_topic_mechanism"'
    order:
      - sequence
      - file.name
      - dimension
      - parent
      - id
