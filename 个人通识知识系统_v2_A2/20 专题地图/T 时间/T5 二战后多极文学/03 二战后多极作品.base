filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-T5-POSTWAR")
properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  postwar_priority:
    displayName: T5优先级
  postwar_stage:
    displayName: 时间阶段
  postwar_axes:
    displayName: 战后问题横轴
  read_status:
    displayName: 阅读状态
  id:
    displayName: 稳定 ID
views:
  - type: table
    name: 全部T5作品
    order:
      - file.name
      - author
      - postwar_priority
      - postwar_stage
      - postwar_axes
      - read_status
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - postwar_priority == "★"
    order:
      - file.name
      - author
      - postwar_stage
      - postwar_axes
      - read_status
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - postwar_priority == "◆"
    order:
      - file.name
      - author
      - postwar_stage
      - postwar_axes
      - read_status
  - type: table
    name: 按时间阶段
    groupBy:
      property: postwar_stage
      direction: ASC
    order:
      - file.name
      - author
      - postwar_priority
      - postwar_axes
  - type: table
    name: 横轴已标注
    filters:
      and:
        - "!postwar_axes.isEmpty()"
    order:
      - file.name
      - author
      - postwar_axes
      - postwar_stage
