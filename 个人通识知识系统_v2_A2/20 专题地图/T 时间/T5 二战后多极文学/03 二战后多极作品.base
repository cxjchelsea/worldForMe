filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-T5-POSTWAR")
properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  postwar_priority:
    displayName: T5优先级
  postwar_stage:
    displayName: 时间阶段
  postwar_axes:
    displayName: 战后问题横轴
  read_status:
    displayName: 阅读状态
  axis_t:
    displayName: T 时间
  axis_r:
    displayName: R 地域
  axis_m:
    displayName: M 思潮
  axis_g:
    displayName: G 类型
  axis_n:
    displayName: N 叙事
  axis_q:
    displayName: Q 主题
  id:
    displayName: 稳定 ID
views:
  - type: table
    name: 全部T5作品
    order:
      - file.name
      - author
      - postwar_priority
      - postwar_stage
      - postwar_axes
      - read_status
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - postwar_priority == "★"
    order:
      - file.name
      - author
      - postwar_stage
      - postwar_axes
      - read_status
  - type: table
    name: 骨架未读
    filters:
      and:
        - postwar_priority == "★"
        - read_status == "未读"
    order:
      - file.name
      - author
      - read_status
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - postwar_priority == "◆"
    order:
      - file.name
      - author
      - postwar_stage
      - postwar_axes
      - read_status
  - type: table
    name: 按时间阶段
    groupBy:
      property: postwar_stage
      direction: ASC
    order:
      - file.name
      - author
      - postwar_priority
      - postwar_axes
  - type: table
    name: 横轴已标注
    filters:
      and:
        - "!postwar_axes.isEmpty()"
    order:
      - file.name
      - author
      - postwar_axes
      - postwar_stage
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - read_status
