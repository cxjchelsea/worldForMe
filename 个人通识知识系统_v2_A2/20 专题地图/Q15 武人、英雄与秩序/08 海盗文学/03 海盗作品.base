filters:
  and:
    - 'type == "work"'
    - 'topics.contains("WL-TOPIC-Q15-PIRATE")'

properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  pirate_priority:
    displayName: 专题优先级
  pirate_history_stage:
    displayName: 历史阶段
  pirate_axes:
    displayName: 内部横轴
  martial_systems:
    displayName: Q15系统
  read_status:
    displayName: 阅读状态
  id:
    displayName: 稳定 ID

views:
  - type: table
    name: 全部海盗作品
    order:
      - file.name
      - author
      - pirate_priority
      - pirate_history_stage
      - pirate_axes
      - read_status
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - 'pirate_priority == "★"'
    order:
      - file.name
      - author
      - pirate_history_stage
      - pirate_axes
      - read_status
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - 'pirate_priority == "◆"'
    order:
      - file.name
      - author
      - pirate_history_stage
      - pirate_axes
      - read_status
  - type: table
    name: 按历史阶段
    groupBy:
      property: pirate_history_stage
      direction: ASC
    order:
      - file.name
      - author
      - pirate_priority
      - pirate_axes
  - type: table
    name: 横轴已标注
    filters:
      and:
        - '!pirate_axes.isEmpty()'
    order:
      - file.name
      - author
      - pirate_axes
      - pirate_history_stage
