filters:
  and:
    - 'type == "work"'
    - 'topics.contains("WL-TOPIC-Q15-SWASHBUCKLER")'

properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  swashbuckler_priority:
    displayName: 专题优先级
  swashbuckler_history_stage:
    displayName: 历史阶段
  swashbuckler_axes:
    displayName: 内部横轴
  martial_systems:
    displayName: Q15系统
  read_status:
    displayName: 阅读状态
  id:
    displayName: 稳定 ID

views:
  - type: table
    name: 全部欧洲剑客作品
    order:
      - file.name
      - author
      - swashbuckler_priority
      - swashbuckler_history_stage
      - swashbuckler_axes
      - read_status
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - 'swashbuckler_priority == "★"'
    order:
      - file.name
      - author
      - swashbuckler_history_stage
      - swashbuckler_axes
      - read_status
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - 'swashbuckler_priority == "◆"'
    order:
      - file.name
      - author
      - swashbuckler_history_stage
      - swashbuckler_axes
      - read_status
  - type: table
    name: 按历史阶段
    groupBy:
      property: swashbuckler_history_stage
      direction: ASC
    order:
      - file.name
      - author
      - swashbuckler_priority
      - swashbuckler_axes
  - type: table
    name: 横轴已标注
    filters:
      and:
        - '!swashbuckler_axes.isEmpty()'
    order:
      - file.name
      - author
      - swashbuckler_axes
      - swashbuckler_history_stage
