filters:
  and:
    - 'type == "work"'
    - 'topics.contains("WL-TOPIC-Q15-KNIGHT")'

properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  knight_priority:
    displayName: 专题优先级
  knight_history_stage:
    displayName: 历史阶段
  knight_axes:
    displayName: 内部横轴
  martial_systems:
    displayName: Q15系统
  read_status:
    displayName: 阅读状态
  id:
    displayName: 稳定 ID

views:
  - type: table
    name: 全部骑士作品
    order:
      - file.name
      - author
      - knight_priority
      - knight_history_stage
      - knight_axes
      - read_status
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - 'knight_priority == "★"'
    order:
      - file.name
      - author
      - knight_history_stage
      - knight_axes
      - read_status
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - 'knight_priority == "◆"'
    order:
      - file.name
      - author
      - knight_history_stage
      - knight_axes
      - read_status
  - type: table
    name: 按历史阶段
    groupBy:
      property: knight_history_stage
      direction: ASC
    order:
      - file.name
      - author
      - knight_priority
      - knight_axes
  - type: table
    name: 横轴已标注
    filters:
      and:
        - '!knight_axes.isEmpty()'
    order:
      - file.name
      - author
      - knight_axes
      - knight_history_stage
