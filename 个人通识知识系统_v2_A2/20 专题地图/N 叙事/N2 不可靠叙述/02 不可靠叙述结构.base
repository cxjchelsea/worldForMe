filters:
  and:
    - 'topic_id == "WL-TOPIC-N2-UNRELIABLE"'

properties:
  file.name:
    displayName: 节点
  type:
    displayName: 类型
  dimension:
    displayName: 维度
  sequence:
    displayName: 顺序
  parent:
    displayName: 父节点
  unreliable_mode:
    displayName: 不可靠机制
  id:
    displayName: 稳定 ID

views:
  - type: table
    name: 全部知识节点
    order:
      - file.name
      - type
      - dimension
      - sequence
      - parent
      - unreliable_mode
      - id

  - type: table
    name: 核心结构
    filters:
      and:
        - 'type == "literature_topic_structure"'
    order:
      - file.name
      - dimension
      - id

  - type: table
    name: 十一种不可靠机制
    filters:
      and:
        - 'type == "literature_topic_section"'
        - 'parent == "WL-TOPIC-N2-UNRELIABLE-MODES"'
    order:
      - sequence
      - file.name
      - unreliable_mode
      - id
