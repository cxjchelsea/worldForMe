filters:
  and:
    - 'type == "work"'
    - 'topics.contains("WL-TOPIC-N2-UNRELIABLE")'

properties:
  file.name:
    displayName: 作品
  author:
    displayName: 作者
  unreliable_priority:
    displayName: 优先级
  unreliable_modes:
    displayName: 不可靠机制
  read_status:
    displayName: 阅读状态
  axis_t:
    displayName: T 时间
  axis_r:
    displayName: R 地域
  axis_m:
    displayName: M 思潮
  axis_g:
    displayName: G 类型
  axis_n:
    displayName: N 叙事
  axis_q:
    displayName: Q 主题
  id:
    displayName: 稳定 ID

views:
  - type: table
    name: 全部N2作品
    order:
      - file.name
      - author
      - unreliable_priority
      - unreliable_modes
      - read_status
  - type: table
    name: 主动隐瞒
    filters:
      and:
        - 'unreliable_modes.contains("主动隐瞒")'
    order:
      - file.name
      - author
      - unreliable_priority
  - type: table
    name: 自相矛盾
    filters:
      and:
        - 'unreliable_modes.contains("自相矛盾")'
    order:
      - file.name
      - author
      - unreliable_priority
  - type: table
    name: 自我欺骗
    filters:
      and:
        - 'unreliable_modes.contains("自我欺骗")'
    order:
      - file.name
      - author
      - unreliable_priority
  - type: table
    name: 价值扭曲
    filters:
      and:
        - 'unreliable_modes.contains("价值扭曲")'
    order:
      - file.name
      - author
      - unreliable_priority
  - type: table
    name: 感知失真
    filters:
      and:
        - 'unreliable_modes.contains("感知失真")'
    order:
      - file.name
      - author
      - unreliable_priority
  - type: table
    name: 解释失真
    filters:
      and:
        - 'unreliable_modes.contains("解释失真")'
    order:
      - file.name
      - author
      - unreliable_priority
  - type: table
    name: 意识破碎
    filters:
      and:
        - 'unreliable_modes.contains("意识破碎")'
    order:
      - file.name
      - author
      - unreliable_priority
  - type: table
    name: 记忆重构
    filters:
      and:
        - 'unreliable_modes.contains("记忆重构")'
    order:
      - file.name
      - author
      - unreliable_priority
  - type: table
    name: 多重证词
    filters:
      and:
        - 'unreliable_modes.contains("多重证词")'
    order:
      - file.name
      - author
      - unreliable_priority
  - type: table
    name: 叙事真相
    filters:
      and:
        - 'unreliable_modes.contains("叙事真相")'
    order:
      - file.name
      - author
      - unreliable_priority
  - type: table
    name: 文本劫持
    filters:
      and:
        - 'unreliable_modes.contains("文本劫持")'
    order:
      - file.name
      - author
      - unreliable_priority
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - read_status
  - type: table
    name: 骨架未读
    filters:
      and:
        - 'unreliable_priority == "★"'
        - 'read_status == "未读"'
    order:
      - file.name
      - author
      - read_status
