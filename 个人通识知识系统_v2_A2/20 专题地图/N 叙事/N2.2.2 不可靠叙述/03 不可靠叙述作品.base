filters:
  and:
    - 'type == "work"'
    - 'topics.contains("WL-TOPIC-N2-UNRELIABLE")'

properties:
  file.name:
    displayName: "作品"
  note.author:
    displayName: "作者"
  note.read_status:
    displayName: "阅读状态"
  note.topic_links:
    displayName: "专题"
  note.topics:
    displayName: "专题编号"
  note.axis_t:
    displayName: "时间"
  note.axis_r:
    displayName: "地域"
  note.axis_m:
    displayName: "思潮"
  note.axis_g:
    displayName: "类型"
  note.axis_n:
    displayName: "叙事"
  note.axis_q:
    displayName: "主题"
  note.id:
    displayName: "编号"
  note.unreliable_priority:
    displayName: "优先级"
  note.unreliable_modes:
    displayName: "机制"
views:
  - type: table
    name: 全部作品
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - unreliable_priority
      - unreliable_modes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - 'unreliable_priority == "★"'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - unreliable_priority
      - unreliable_modes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 骨架未读
    filters:
      and:
        - 'unreliable_priority == "★"'
        - 'read_status == "未读"'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - unreliable_priority
      - unreliable_modes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 按机制
    groupBy:
      property: unreliable_modes
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - unreliable_priority
      - unreliable_modes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 主动隐瞒
    filters:
      and:
        - 'unreliable_modes.contains("主动隐瞒")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - unreliable_priority
      - unreliable_modes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 自相矛盾
    filters:
      and:
        - 'unreliable_modes.contains("自相矛盾")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - unreliable_priority
      - unreliable_modes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 自我欺骗
    filters:
      and:
        - 'unreliable_modes.contains("自我欺骗")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - unreliable_priority
      - unreliable_modes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 价值扭曲
    filters:
      and:
        - 'unreliable_modes.contains("价值扭曲")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - unreliable_priority
      - unreliable_modes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 感知失真
    filters:
      and:
        - 'unreliable_modes.contains("感知失真")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - unreliable_priority
      - unreliable_modes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 解释失真
    filters:
      and:
        - 'unreliable_modes.contains("解释失真")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - unreliable_priority
      - unreliable_modes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 意识破碎
    filters:
      and:
        - 'unreliable_modes.contains("意识破碎")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - unreliable_priority
      - unreliable_modes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 记忆重构
    filters:
      and:
        - 'unreliable_modes.contains("记忆重构")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - unreliable_priority
      - unreliable_modes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 多重证词
    filters:
      and:
        - 'unreliable_modes.contains("多重证词")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - unreliable_priority
      - unreliable_modes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 叙事真相
    filters:
      and:
        - 'unreliable_modes.contains("叙事真相")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - unreliable_priority
      - unreliable_modes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 文本劫持
    filters:
      and:
        - 'unreliable_modes.contains("文本劫持")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - unreliable_priority
      - unreliable_modes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - unreliable_priority
      - unreliable_modes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - unreliable_priority
      - unreliable_modes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
