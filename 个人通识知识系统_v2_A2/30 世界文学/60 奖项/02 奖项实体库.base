filters:
  and:
    - type == "award"
formulas:
  topics_zh: if(related_topics, related_topics.join("、").replace("WL-TOPIC-G43-BILDUNGSROMAN", "成长文学").replace("WL-TOPIC-Q15-SWASHBUCKLER", "欧洲剑客文学").replace("WL-TOPIC-G46-DYSTOPIA", "反乌托邦文学").replace("WL-TOPIC-M3-MODERNISM", "现代主义文学").replace("WL-TOPIC-G45-ADVENTURE", "冒险文学").replace("WL-TOPIC-G44-HISTORICAL", "历史文学").replace("WL-TOPIC-G45-FANTASY", "奇幻文学").replace("WL-TOPIC-G45-MYSTERY", "推理文学").replace("WL-TOPIC-Q15-SAMURAI", "日本武士与剑豪文学").replace("WL-TOPIC-Q15-WESTERN", "西部文学").replace("WL-TOPIC-G43-FAMILY", "家族文学").replace("WL-TOPIC-G45-HORROR", "恐怖文学").replace("WL-TOPIC-Q10-MEMORY", "历史、记忆与时间").replace("WL-TOPIC-Q15-GAUCHO", "Gaucho文学").replace("WL-TOPIC-Q15-KNIGHT", "欧洲骑士文学").replace("WL-TOPIC-Q15-OUTLAW", "侠盗文学").replace("WL-TOPIC-Q15-PIRATE", "海盗文学").replace("WL-TOPIC-T5-POSTWAR", "二战后多极文学").replace("WL-TOPIC-G7-TRAVEL", "旅行文学").replace("WL-TOPIC-Q15-WUXIA", "武侠文学").replace("WL-TOPIC-R6-LATAM", "拉丁美洲文学").replace("WL-TOPIC-G1-MYTH", "世界神话文学").replace("WL-TOPIC-Q2-LOVE", "爱情文学").replace("WL-TOPIC-G45-SF", "科幻文学").replace("WL-TOPIC-Q6-WAR", "战争文学").replace("WL-TOPIC-Q15", "世界武人、边疆与法外英雄文学"), "")
properties:
  file.name:
    displayName: 奖项
  note.name:
    displayName: 标准名称
  note.name_original:
    displayName: 原文名
  note.aliases:
    displayName: 别名
  note.award_object:
    displayName: 颁奖对象
  note.award_scope:
    displayName: 范围
  formula.topics_zh:
    displayName: 相关专题
  note.related_topics:
    displayName: 相关专题
  note.award_map_status:
    displayName: 专题状态
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部奖项实体
    order:
      - file.name
      - name_original
      - aliases
      - award_object
      - award_scope
      - formula.topics_zh
      - award_map_status
      - id
  - type: table
    name: 已建奖项专题
    filters:
      and:
        - award_map_status == "已建立"
    order:
      - file.name
      - name_original
      - aliases
      - award_object
      - award_scope
      - formula.topics_zh
      - award_map_status
      - id
