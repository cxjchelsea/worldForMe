{"nodes":[{"id":"root","type":"file","x":680,"y":0,"width":520,"height":110,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/M3.1 现代主义/00 现代主义文学.md"},{"id":"context","type":"text","x":60,"y":190,"width":420,"height":190,"text":"# 历史条件 / 现代性压力\n都市化与工业社会\n战争与文明秩序震动\n新媒体与感知节奏\n心理学与主体观变化\n帝国、殖民与非同步现代性"},{"id":"problem","type":"text","x":560,"y":190,"width":420,"height":190,"text":"# 核心问题\n稳定主体不再可信\n线性时间不足\n语言不再透明\n传统现实主义再现出现不足\n不同地区并不共享同一种现代性"},{"id":"response","type":"file","x":1060,"y":210,"width":450,"height":100,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/M3.1 现代主义/10 结构/03 现代经验与形式机制.md"},{"id":"boundary","type":"file","x":1580,"y":210,"width":450,"height":100,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/M3.1 现代主义/10 结构/07 现代主义与先锋派的边界.md"},{"id":"period","type":"file","x":220,"y":490,"width":450,"height":100,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/M3.1 现代主义/10 结构/06 现代主义的历史分期与内部层次.md"},{"id":"early","type":"file","x":0,"y":680,"width":390,"height":90,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/M3.1 现代主义/13 内部结构/01 前史与早期现代主义.md"},{"id":"high","type":"file","x":430,"y":680,"width":390,"height":90,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/M3.1 现代主义/13 内部结构/02 高度现代主义.md"},{"id":"late","type":"file","x":860,"y":680,"width":390,"height":90,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/M3.1 现代主义/13 内部结构/03 晚期现代主义与战后转向.md"},{"id":"regions","type":"file","x":760,"y":490,"width":450,"height":100,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/M3.1 现代主义/10 结构/02 全球现代主义传统.md"},{"id":"mechanism","type":"file","x":1300,"y":490,"width":450,"height":100,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/M3.1 现代主义/12 现代主义机制/01 十五条形式与经验横轴.md"},{"id":"global","type":"file","x":1810,"y":490,"width":450,"height":100,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/M3.1 现代主义/12 现代主义机制/02 Global Modernism与殖民现代性.md"},{"id":"structdb","type":"file","x":1080,"y":870,"width":430,"height":90,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/M3.1 现代主义/02 现代主义文学结构.base"},{"id":"works","type":"file","x":1580,"y":870,"width":430,"height":90,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/M3.1 现代主义/03 现代主义作品.base"},{"id":"route","type":"file","x":550,"y":870,"width":430,"height":90,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/M3.1 现代主义/10 结构/05 阅读路线.md"}],"edges":[{"id":"e1","fromNode":"root","toNode":"context"},{"id":"e2","fromNode":"context","toNode":"problem"},{"id":"e3","fromNode":"problem","toNode":"response"},{"id":"e4","fromNode":"response","toNode":"boundary"},{"id":"e5","fromNode":"response","toNode":"period"},{"id":"e6","fromNode":"response","toNode":"regions"},{"id":"e7","fromNode":"response","toNode":"mechanism"},{"id":"e8","fromNode":"period","toNode":"early"},{"id":"e9","fromNode":"period","toNode":"high"},{"id":"e10","fromNode":"period","toNode":"late"},{"id":"e11","fromNode":"regions","toNode":"global"},{"id":"e12","fromNode":"mechanism","toNode":"global"},{"id":"e13","fromNode":"early","toNode":"route"},{"id":"e14","fromNode":"high","toNode":"route"},{"id":"e15","fromNode":"late","toNode":"route"},{"id":"e16","fromNode":"route","toNode":"structdb"},{"id":"e17","fromNode":"global","toNode":"structdb"},{"id":"e18","fromNode":"structdb","toNode":"works"}]}