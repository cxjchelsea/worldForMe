filters:
  and:
    - type == "work"
    - axis_t.contains("T6 当代全球文学")
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.topic_links:
    displayName: 专题
  note.topics:
    displayName: 专题编号
  note.t6_priority:
    displayName: 优先级
  note.t6_history_position:
    displayName: 历史位置
  note.t6_mechanism:
    displayName: 机制
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 类型
  note.axis_q:
    displayName: 主题
  note.id:
    displayName: 编号
  note.verification_status:
    displayName: 校验状态
views:
  - type: table
    name: 全部 T6 作品
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - t6_priority
      - t6_history_position
      - t6_mechanism
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: T6 骨架路线
    filters:
      and:
        - or:
            - file.name == "午夜之子"
            - file.name == "宠儿"
            - file.name == "使女的故事"
            - file.name == "长日将尽"
            - file.name == "活着"
            - file.name == "挪威的森林"
            - file.name == "三体"
            - file.name == "微物之神"
            - file.name == "耻"
            - file.name == "半轮黄日"
            - file.name == "霍乱时期的爱情"
            - file.name == "2666"
            - file.name == "我的名字叫红"
            - file.name == "追风筝的人"
            - file.name == "素食者"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - t6_priority
      - t6_history_position
      - t6_mechanism
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 骨架与重点
    filters:
      and:
        - or:
            - t6_priority == "★"
            - t6_priority == "◆"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - t6_priority
      - t6_history_position
      - t6_mechanism
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - t6_priority
      - t6_history_position
      - t6_mechanism
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - t6_priority
      - t6_history_position
      - t6_mechanism
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按地域
    groupBy:
      property: axis_r
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - t6_priority
      - t6_history_position
      - t6_mechanism
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按类型
    groupBy:
      property: axis_g
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - t6_priority
      - t6_history_position
      - t6_mechanism
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 待校验
    filters:
      and:
        - verification_status != "自动通过"
        - verification_status != "手工核验"
    order:
      - file.name
      - author
      - verification_status
      - t6_priority
      - t6_history_position
      - t6_mechanism
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
