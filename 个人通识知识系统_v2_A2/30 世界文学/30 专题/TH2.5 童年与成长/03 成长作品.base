filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-G43-BILDUNGSROMAN")
properties:
  file.name: {displayName: 作品}
  note.author: {displayName: 作者}
  note.read_status: {displayName: 阅读状态}
  note.growth_priority: {displayName: 优先级}
  note.growth_role: {displayName: 专题角色}
  note.growth_problems: {displayName: 核心问题}
  note.growth_note: {displayName: 专题价值}
  note.growth_history_cluster: {displayName: 旧历史位置}
  note.growth_axes: {displayName: 旧机制标签}
  note.axis_t: {displayName: 时间}
  note.axis_r: {displayName: 地域}
  note.axis_m: {displayName: 思潮}
  note.axis_g: {displayName: 体裁}
  note.axis_th: {displayName: 主题}
  note.id: {displayName: 编号}
views:
  - {type: table, name: 核心 ★, filters: {and: [growth_priority == "★"]}, order: [file.name, author, read_status, growth_role, growth_problems, growth_note, growth_history_cluster, axis_t, axis_r, axis_m, axis_g, axis_th]}
  - {type: table, name: 重点 ◆, filters: {and: [growth_priority == "◆"]}, order: [file.name, author, read_status, growth_role, growth_problems, growth_note, growth_history_cluster]}
  - {type: table, name: 扩展 △, filters: {and: [growth_priority == "△"]}, order: [file.name, author, read_status, growth_role, growth_problems, growth_note]}
  - {type: table, name: 已读, filters: {or: [read_status == "已读", read_status == "重读"]}, order: [file.name, author, growth_priority, growth_role, growth_problems, axis_t, axis_r, axis_m, axis_g]}
  - {type: table, name: 未读, filters: {and: [read_status == "未读"]}, order: [file.name, author, growth_priority, growth_role, growth_problems, axis_t, axis_r, axis_m, axis_g]}
  - {type: table, name: 全部作品, order: [file.name, author, growth_priority, growth_role, read_status, growth_problems, growth_note, growth_history_cluster, growth_axes, axis_t, axis_r, axis_m, axis_g, axis_th, id]}
