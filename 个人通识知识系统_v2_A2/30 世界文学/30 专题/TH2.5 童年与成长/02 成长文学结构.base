filters:
  and:
    - topic_id == "WL-TOPIC-G43-BILDUNGSROMAN"
formulas:
  type_zh: type.replace("literature_topic_problem", "核心问题").replace("literature_topic_structure", "结构").replace("literature_topic_mechanism", "机制比较").replace("literature_topic_section", "历史细分").replace("literature_topic_map", "专题")
properties:
  file.name:
    displayName: 节点
  formula.type_zh:
    displayName: 类型
  note.problem_code:
    displayName: 问题编号
  note.dimension:
    displayName: 维度
  note.sequence:
    displayName: 顺序
  note.status:
    displayName: 状态
  note.history_cluster:
    displayName: 历史位置
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部知识节点
    groupBy:
      property: formula.type_zh
      direction: ASC
    order:
      - file.name
      - formula.type_zh
      - problem_code
      - dimension
      - sequence
      - status
      - history_cluster
      - id
  - type: table
    name: 七个核心问题
    filters:
      and:
        - type == "literature_topic_problem"
    order:
      - problem_code
      - file.name
      - sequence
      - status
      - id
  - type: table
    name: 结构与终审
    filters:
      and:
        - type == "literature_topic_structure"
    order:
      - file.name
      - dimension
      - sequence
      - status
  - type: table
    name: 旧历史细分
    filters:
      and:
        - type == "literature_topic_section"
    order:
      - file.name
      - history_cluster
      - sequence
  - type: table
    name: 旧机制比较
    filters:
      and:
        - type == "literature_topic_mechanism"
    order:
      - file.name
      - dimension
      - sequence
