filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-TH1-5-MEANING-ABSURD")
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.meaning_role:
    displayName: 专题角色
  note.meaning_priority:
    displayName: 优先级
  note.meaning_dimensions:
    displayName: 意义与荒诞问题维度
  note.meaning_note:
    displayName: 专题价值
  note.topic_links:
    displayName: 专题
  note.topics:
    displayName: 专题编号
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 类型
  note.axis_q:
    displayName: 主题
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部作品
    groupBy:
      property: meaning_role
      direction: ASC
    order:
      - file.name
      - author
      - meaning_role
      - meaning_priority
      - read_status
      - meaning_dimensions
      - meaning_note
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 骨架作品
    filters:
      and:
        - meaning_role == "骨架"
    order:
      - file.name
      - author
      - meaning_priority
      - read_status
      - meaning_dimensions
      - meaning_note
      - axis_t
      - axis_r
  - type: table
    name: 比较与边界
    filters:
      or:
        - meaning_role == "比较"
        - meaning_role == "边界测试"
    order:
      - file.name
      - author
      - meaning_role
      - meaning_priority
      - read_status
      - meaning_dimensions
      - meaning_note
      - axis_t
      - axis_r
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - meaning_role
      - meaning_priority
      - meaning_dimensions
      - axis_t
      - axis_r
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - meaning_role
      - meaning_priority
      - meaning_dimensions
      - axis_t
      - axis_r
