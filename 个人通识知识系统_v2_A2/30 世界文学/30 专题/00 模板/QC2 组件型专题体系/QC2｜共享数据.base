properties:
  file.name:
    displayName: 记录
  note.type:
    displayName: 类型
  note.component_id:
    displayName: 组件
  note.component_type:
    displayName: 组件类型
  note.source_tradition:
    displayName: 来源传统
  note.source_story:
    displayName: 来源故事
  note.source_text:
    displayName: 来源文本
  note.source_status:
    displayName: 来源状态
  note.tradition_role:
    displayName: 来源角色
  note.source_component:
    displayName: 起点组件
  note.target_component:
    displayName: 终点组件
  note.work:
    displayName: 作品
  note.work_role:
    displayName: 作品角色
  note.relation_type:
    displayName: 关系类型
  note.evidence_level:
    displayName: 证据等级
  note.canonical_work:
    displayName: 主作品节点
  note.sequence:
    displayName: 顺序
views:
  - type: table
    name: 来源引用
    filters:
      and:
        - 'type == "qc2_source_reference"'
    order:
      - component_id
      - sequence
      - source_tradition
      - source_story
      - source_text
      - source_status
      - tradition_role
      - canonical_work
  - type: table
    name: 组件关系
    filters:
      and:
        - 'type == "qc2_component_relation"'
    order:
      - source_component
      - target_component
      - relation_type
      - evidence_level
      - sequence
  - type: table
    name: 作品实例
    filters:
      and:
        - 'type == "qc2_work_reference"'
    order:
      - component_id
      - sequence
      - work
      - work_role
      - relation_type
      - evidence_level
      - canonical_work
  - type: table
    name: 全部 QC2 数据记录
    filters:
      or:
        - 'type == "qc2_source_reference"'
        - 'type == "qc2_component_relation"'
        - 'type == "qc2_work_reference"'
    order:
      - type
      - component_id
      - sequence
      - file.name
