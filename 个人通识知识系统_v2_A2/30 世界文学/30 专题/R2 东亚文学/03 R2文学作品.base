filters:
  and:
    - type == "work"
    - axis_r.contains("R2 东亚文学")
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.year:
    displayName: 年份
  note.read_status:
    displayName: 阅读状态
  note.r2_priority:
    displayName: R2优先级
  note.r2_tradition:
    displayName: 内部传统
  note.r2_role:
    displayName: R2机制/意义
  note.axis_t:
    displayName: 时间
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 类型
  note.axis_q:
    displayName: 主题
  note.verification_status:
    displayName: 校验状态
views:
  - type: table
    name: 全部 R2 作品
    order: [file.name, author, year, read_status, r2_priority, r2_tradition, r2_role, axis_t]
  - type: table
    name: 核心 ★
    filters:
      and:
        - r2_priority == "★"
    order: [file.name, author, year, r2_tradition, r2_role, axis_t]
  - type: table
    name: 按内部传统
    groupBy:
      property: r2_tradition
      direction: ASC
    order: [file.name, author, year, r2_priority, r2_role, axis_t]
  - type: table
    name: 待校验
    filters:
      and:
        - verification_status != "自动通过"
        - verification_status != "手工核验"
    order: [file.name, author, year, verification_status]
