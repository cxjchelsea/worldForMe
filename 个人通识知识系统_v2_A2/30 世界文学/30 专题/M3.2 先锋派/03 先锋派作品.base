filters:
  and:
    - type == "work"
    - file.folder == "个人通识知识系统_v2_A2/30 世界文学/40 作品"
    - or:
        - m32_priority == "★"
        - m32_priority == "◆"
        - m32_priority == "△"
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.topic_links:
    displayName: 专题
  note.topics:
    displayName: 专题编号
  note.m32_priority:
    displayName: 优先级
  note.m32_movement_cluster:
    displayName: 专题思潮
  note.m32_history_position:
    displayName: 历史位置
  note.m32_axes:
    displayName: 专题机制
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: M轴坐标
  note.axis_g:
    displayName: 类型
  note.axis_q:
    displayName: 主题
  note.id:
    displayName: 编号
  note.verification_status:
    displayName: 校验状态
views:
  - type: table
    name: 全部作品
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - m32_priority
      - m32_movement_cluster
      - m32_history_position
      - m32_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 核心 ★
    filters:
      and:
        - m32_priority == "★"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - m32_priority
      - m32_movement_cluster
      - m32_history_position
      - m32_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 重点 ◆
    filters:
      and:
        - m32_priority == "◆"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - m32_priority
      - m32_movement_cluster
      - m32_history_position
      - m32_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 扩展 △
    filters:
      and:
        - m32_priority == "△"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - m32_priority
      - m32_movement_cluster
      - m32_history_position
      - m32_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - m32_priority
      - m32_movement_cluster
      - m32_history_position
      - m32_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - m32_priority
      - m32_movement_cluster
      - m32_history_position
      - m32_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按历史位置
    groupBy:
      property: m32_history_position
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - m32_priority
      - m32_movement_cluster
      - m32_history_position
      - m32_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按专题思潮
    groupBy:
      property: m32_movement_cluster
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - m32_priority
      - m32_movement_cluster
      - m32_history_position
      - m32_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按地域
    groupBy:
      property: axis_r
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - m32_priority
      - m32_movement_cluster
      - m32_history_position
      - m32_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按M轴坐标
    groupBy:
      property: axis_m
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - m32_priority
      - m32_movement_cluster
      - m32_history_position
      - m32_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按类型
    groupBy:
      property: axis_g
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - m32_priority
      - m32_movement_cluster
      - m32_history_position
      - m32_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按主题
    groupBy:
      property: axis_q
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - m32_priority
      - m32_movement_cluster
      - m32_history_position
      - m32_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 待校验
    filters:
      and:
        - verification_status != "自动通过"
        - verification_status != "手工核验"
    order:
      - file.name
      - author
      - verification_status
      - topic_links
      - m32_priority
      - m32_movement_cluster
      - m32_history_position
      - m32_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
