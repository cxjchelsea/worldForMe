filters:
  and:
    - type == "work"
    - axis_t.contains("T1 中古多中心文学世界")
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.topic_links:
    displayName: 专题
  note.topics:
    displayName: 专题编号
  note.t1_priority:
    displayName: 优先级
  note.t1_network:
    displayName: 历史位置
  note.t1_role:
    displayName: 机制
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 类型
  note.axis_q:
    displayName: 主题
  note.id:
    displayName: 编号
  note.verification_status:
    displayName: 校验状态
views:
  - type: table
    name: 全部 T1 作品
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - t1_priority
      - t1_network
      - t1_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 骨架与重点
    filters:
      and:
        - or:
            - t1_priority == "★"
            - t1_priority == "◆"
    groupBy:
      property: t1_network
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - t1_priority
      - t1_network
      - t1_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按文学网络
    groupBy:
      property: t1_network
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - t1_priority
      - t1_network
      - t1_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - t1_priority
      - t1_network
      - t1_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - t1_priority
      - t1_network
      - t1_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按地域
    groupBy:
      property: axis_r
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - t1_priority
      - t1_network
      - t1_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按类型
    groupBy:
      property: axis_g
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - t1_priority
      - t1_network
      - t1_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 待校验
    filters:
      and:
        - verification_status != "自动通过"
    order:
      - file.name
      - author
      - verification_status
      - topic_links
      - t1_priority
      - t1_network
      - t1_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
