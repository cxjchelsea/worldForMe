filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-TH2-4-PARENT-CHILD-GENERATIONS")
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.topic_links:
    displayName: 专题
  note.topics:
    displayName: 专题编号
  note.parent_child_role:
    displayName: 专题角色
  note.parent_child_priority:
    displayName: 优先级
  note.parent_child_problems:
    displayName: 核心问题
  note.parent_child_note:
    displayName: 专题价值
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 体裁
  note.axis_th:
    displayName: 主题
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部作品
    groupBy:
      property: parent_child_role
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - parent_child_role
      - parent_child_priority
      - parent_child_problems
      - parent_child_note
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_th
      - id
  - type: table
    name: 骨架作品 ★
    filters:
      and:
        - parent_child_role == "骨架"
    order:
      - file.name
      - author
      - read_status
      - parent_child_priority
      - parent_child_problems
      - parent_child_note
      - id
  - type: table
    name: 比较作品 ◆
    filters:
      and:
        - parent_child_role == "比较"
    order:
      - file.name
      - author
      - read_status
      - parent_child_priority
      - parent_child_problems
      - parent_child_note
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - parent_child_role
      - parent_child_priority
      - parent_child_problems
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - parent_child_role
      - parent_child_priority
      - parent_child_problems
      - id
