filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-G43-FAMILY")
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.topic_links:
    displayName: 专题
  note.topics:
    displayName: 专题编号
  note.family_role:
    displayName: 专题角色
  note.family_priority:
    displayName: 优先级
  note.family_problems:
    displayName: 核心问题
  note.family_note:
    displayName: 专题价值
  note.family_history_cluster:
    displayName: 历史比较
  note.family_axes:
    displayName: 旧机制标签
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 体裁
  note.axis_th:
    displayName: 主题
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部作品
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - family_role
      - family_priority
      - family_problems
      - family_note
      - family_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_th
      - id
  - type: table
    name: 骨架作品 ★
    filters:
      and:
        - family_role == "骨架"
    order:
      - file.name
      - author
      - read_status
      - family_priority
      - family_problems
      - family_note
      - id
  - type: table
    name: 比较作品 ◆
    filters:
      and:
        - family_role == "比较"
    order:
      - file.name
      - author
      - read_status
      - family_priority
      - family_problems
      - family_note
      - id
  - type: table
    name: 按历史比较
    groupBy:
      property: family_history_cluster
      direction: ASC
    order:
      - file.name
      - author
      - family_role
      - family_history_cluster
      - family_problems
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - family_role
      - family_priority
      - family_problems
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - family_role
      - family_priority
      - family_problems
      - id
