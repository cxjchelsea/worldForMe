filters:
  and:
    - topic_id == "WL-TOPIC-G43-FAMILY"
formulas:
  type_zh: type.replace("literature_topic_problem", "核心问题").replace("literature_topic_structure", "核心结构").replace("literature_topic_section", "历史比较").replace("literature_topic_mechanism", "类型与机制比较").replace("literature_topic_map", "专题")
  dimension_zh: if(dimension, dimension.replace("core_problem", "核心问题").replace("work_stress_test", "作品压力测试").replace("freeze_review", "冻结终审").replace("definition", "定义与边界").replace("history", "历史比较").replace("family_axes", "家族机制").replace("bridge", "跨专题桥接"), "")
properties:
  file.name:
    displayName: 节点
  formula.type_zh:
    displayName: 类型
  formula.dimension_zh:
    displayName: 维度
  note.problem_code:
    displayName: 问题编号
  note.sequence:
    displayName: 顺序
  note.parent:
    displayName: 父节点
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部知识节点
    groupBy:
      property: formula.type_zh
      direction: ASC
    order:
      - file.name
      - formula.type_zh
      - formula.dimension_zh
      - problem_code
      - sequence
      - id
  - type: table
    name: 七个核心问题
    filters:
      and:
        - type == "literature_topic_problem"
    order:
      - problem_code
      - file.name
      - id
  - type: table
    name: 核心结构
    filters:
      and:
        - type == "literature_topic_structure"
    order:
      - file.name
      - formula.dimension_zh
      - sequence
      - id
  - type: table
    name: 旧历史与机制比较
    filters:
      or:
        - type == "literature_topic_section"
        - type == "literature_topic_mechanism"
    order:
      - file.name
      - formula.type_zh
      - formula.dimension_zh
      - sequence
      - id
