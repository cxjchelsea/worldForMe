filters:
  and:
    - topic_id == "WL-TOPIC-R10-TRANSREGIONAL"
properties:
  file.name: {displayName: 节点}
  note.dimension: {displayName: 维度}
  note.sequence: {displayName: 顺序}
views:
  - type: table
    name: 全部 R10 知识节点
    order: [file.name, dimension, sequence]
  - type: table
    name: 跨区域传统
    filters:
      and:
        - dimension == "internal_tradition"
    order: [file.name, sequence]
  - type: table
    name: 跨传统网络
    filters:
      and:
        - dimension == "literary_network"
    order: [file.name, sequence]
