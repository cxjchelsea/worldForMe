filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-QH1-4-DEATH")
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.death_role:
    displayName: 专题角色
  note.death_priority:
    displayName: 优先级
  note.death_dimensions:
    displayName: 死亡问题
  note.death_note:
    displayName: 专题说明
  note.axis_t:
    displayName: T
  note.axis_r:
    displayName: R
  note.axis_m:
    displayName: M
  note.axis_g:
    displayName: G
  note.axis_q:
    displayName: Q
  note.id:
    displayName: Work ID
views:
  - type: table
    name: 全部作品
    groupBy:
      property: note.death_role
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - death_priority
      - death_dimensions
      - death_note
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 骨架作品
    filters:
      and:
        - death_role == "骨架"
    order:
      - death_priority
      - file.name
      - death_dimensions
  - type: table
    name: 比较与边界
    filters:
      or:
        - death_role == "比较"
        - death_role == "边界测试"
    order:
      - death_role
      - death_priority
      - file.name
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - death_priority
      - file.name
  - type: table
    name: 已读
    filters:
      and:
        - read_status == "已读"
    order:
      - death_priority
      - file.name
