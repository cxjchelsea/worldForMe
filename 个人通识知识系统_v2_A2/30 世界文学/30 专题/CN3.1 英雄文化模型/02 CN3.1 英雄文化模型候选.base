filters:
  and:
    - type == "qc3_candidate"
    - cluster_id == "WL-CN3.1"
properties:
  file.name:
    displayName: 候选模型
  note.status:
    displayName: 状态
  note.admission_score:
    displayName: 准入分
  note.legacy_code:
    displayName: 旧编号
  note.migration_mode:
    displayName: 迁移方式
  note.historical_basis:
    displayName: 历史基底
  note.role_ethic_structure:
    displayName: 角色/伦理结构
  note.cross_period_life:
    displayName: 跨时期生命
  note.qc1_readiness:
    displayName: CN1 可接性
  note.qc2_readiness:
    displayName: CN2 可接性
  note.work_readiness:
    displayName: 作品准备度
  note.reuse_value:
    displayName: 复用价值
  note.overlap_risk:
    displayName: 重叠风险
  note.formal_topic:
    displayName: 正式专题
views:
  - type: table
    name: 全部候选
    order:
      - file.name
      - status
      - admission_score
      - legacy_code
      - migration_mode
      - historical_basis
      - role_ethic_structure
      - cross_period_life
      - qc1_readiness
      - qc2_readiness
      - work_readiness
      - reuse_value
      - overlap_risk
  - type: table
    name: 已接受
    filters:
      and:
        - status == "ACCEPTED"
    order:
      - file.name
      - admission_score
      - legacy_code
      - formal_topic
  - type: table
    name: 旧TY8.3迁移
    filters:
      and:
        - legacy_code != null
    order:
      - file.name
      - legacy_code
      - migration_mode
      - status
      - admission_score
  - type: table
    name: Pilot与可准入
    filters:
      or:
        - status == "PILOT"
        - status == "READY_FOR_ADMISSION"
    order:
      - file.name
      - status
      - admission_score
      - qc1_readiness
      - qc2_readiness
      - work_readiness
  - type: table
    name: 待补证据
    filters:
      and:
        - status == "NEEDS_EVIDENCE"
    order:
      - file.name
      - admission_score
      - legacy_code
      - overlap_risk
