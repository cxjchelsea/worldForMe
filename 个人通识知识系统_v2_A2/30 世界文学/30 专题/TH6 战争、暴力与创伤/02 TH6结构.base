filters:
  or:
    - topic_id == "WL-TOPIC-Q6-WAR"
    - file.path.startsWith("个人通识知识系统_v2_A2/30 世界文学/30 专题/TH6 战争、暴力与创伤/10 结构/")
    - file.path.startsWith("个人通识知识系统_v2_A2/30 世界文学/30 专题/TH6 战争、暴力与创伤/13 TH6核心问题/")
formulas:
  type_zh: if(type == "literature_topic_structure", "核心结构", if(type == "literature_topic_problem" || type == "literature_topic_section", "核心问题/细分", if(type == "literature_topic_mechanism", "机制深化", "兼容节点")))
  dimension_zh: if(dimension, dimension.replace("core_problem", "核心问题").replace("definition", "定义与边界").replace("mechanism", "作用机制").replace("comparison", "跨轴比较").replace("reading_route", "阅读路线").replace("review", "终审与校准").replace("war_axes", "战争横轴").replace("history", "历史").replace("bridge", "桥接"), "")
properties:
  file.name: {displayName: 节点}
  formula.type_zh: {displayName: 类型}
  formula.dimension_zh: {displayName: 维度}
  note.sequence: {displayName: 顺序}
  note.parent: {displayName: 父节点}
  note.problem_code: {displayName: 问题编号}
  note.war_history_stage: {displayName: 历史位置}
  note.question_cluster: {displayName: 战争机制}
  note.status: {displayName: 状态}
  note.id: {displayName: 编号}
views:
  - type: table
    name: 全部知识节点
    order: [file.name, formula.type_zh, formula.dimension_zh, problem_code, sequence, parent, war_history_stage, question_cluster, status, id]
  - type: table
    name: A级核心结构
    filters: {and: [file.path.startsWith("个人通识知识系统_v2_A2/30 世界文学/30 专题/TH6 战争、暴力与创伤/10 结构/")]}
    order: [file.name, formula.dimension_zh, sequence, id]
  - type: table
    name: TH6核心问题
    filters: {and: [file.path.startsWith("个人通识知识系统_v2_A2/30 世界文学/30 专题/TH6 战争、暴力与创伤/13 TH6核心问题/")]}
    order: [problem_code, file.name, status, id]
  - type: table
    name: 旧战争细分
    filters: {and: [type == "literature_topic_section"]}
    order: [file.name, war_history_stage, question_cluster, sequence, id]
  - type: table
    name: 旧战争机制深化
    filters: {and: [type == "literature_topic_mechanism"]}
    order: [file.name, formula.dimension_zh, question_cluster, sequence, id]
