filters:
  and:
    - 'type == "work"'
    - 'topics.contains("WL-TOPIC-Q6-WAR")'

properties:
  file.name:
    displayName: "作品"
  note.author:
    displayName: "作者"
  note.read_status:
    displayName: "阅读状态"
  note.topic_links:
    displayName: "专题"
  note.topics:
    displayName: "专题编号"
  note.axis_t:
    displayName: "时间"
  note.axis_r:
    displayName: "地域"
  note.axis_m:
    displayName: "思潮"
  note.axis_g:
    displayName: "类型"
  note.axis_q:
    displayName: "主题"
  note.id:
    displayName: "编号"
  note.war_priority:
    displayName: "优先级"
  note.war_history_stage:
    displayName: "历史位置"
  note.war_axes:
    displayName: "机制"
views:
  - type: table
    name: 全部作品
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - war_priority
      - war_history_stage
      - war_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - 'war_priority == "★"'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - war_priority
      - war_history_stage
      - war_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 骨架未读
    filters:
      and:
        - 'war_priority == "★"'
        - 'read_status == "未读"'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - war_priority
      - war_history_stage
      - war_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - 'war_priority == "◆"'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - war_priority
      - war_history_stage
      - war_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 边界 △
    filters:
      and:
        - 'war_priority == "△"'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - war_priority
      - war_history_stage
      - war_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按历史
    groupBy:
      property: war_history_stage
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - war_priority
      - war_history_stage
      - war_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 问题 战斗与士兵
    filters:
      and:
        - or:
            - 'war_axes.contains("英雄主义")'
            - 'war_axes.contains("普通士兵")'
            - 'war_axes.contains("反战")'
            - 'war_axes.contains("荒诞")'
            - 'war_axes.contains("军事制度")'
            - 'war_axes.contains("战俘")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - war_priority
      - war_history_stage
      - war_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 问题 平民与占领
    filters:
      and:
        - or:
            - 'war_axes.contains("平民")'
            - 'war_axes.contains("占领")'
            - 'war_axes.contains("女性")'
            - 'war_axes.contains("儿童")'
            - 'war_axes.contains("战争与爱情")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - war_priority
      - war_history_stage
      - war_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 问题 灭绝与核暴力
    filters:
      and:
        - or:
            - 'war_axes.contains("Holocaust/Genocide")'
            - 'war_axes.contains("轰炸与核战争")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - war_priority
      - war_history_stage
      - war_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 问题 内战与殖民战争
    filters:
      and:
        - or:
            - 'war_axes.contains("内战")'
            - 'war_axes.contains("殖民战争")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - war_priority
      - war_history_stage
      - war_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 问题 创伤与记忆
    filters:
      and:
        - or:
            - 'war_axes.contains("创伤/Afterwar")'
            - 'war_axes.contains("战争记忆")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - war_priority
      - war_history_stage
      - war_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 问题 真相与责任
    filters:
      and:
        - or:
            - 'war_axes.contains("战争真相与叙事")'
            - 'war_axes.contains("加害者/Complicity")'
            - 'war_axes.contains("战争×类型融合")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - war_priority
      - war_history_stage
      - war_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 未读
    filters:
      and:
        - 'read_status == "未读"'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - war_priority
      - war_history_stage
      - war_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - war_priority
      - war_history_stage
      - war_axes
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
