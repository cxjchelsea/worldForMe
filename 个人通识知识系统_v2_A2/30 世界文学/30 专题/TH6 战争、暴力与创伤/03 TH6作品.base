filters:
  and:
    - file.path.startsWith("个人通识知识系统_v2_A2/30 世界文学/40 作品/")
    - topics.contains("WL-TOPIC-Q6-WAR")
properties:
  file.link:
    displayName: 作品
  note.violence_trauma_role:
    displayName: TH6角色
  note.violence_trauma_priority:
    displayName: TH6优先级
  note.violence_trauma_problems:
    displayName: TH6问题
  note.violence_trauma_note:
    displayName: TH6说明
  note.war_history_stage:
    displayName: 战争史位置（旧）
  note.war_axes:
    displayName: 战争机制（旧）
views:
  - type: table
    name: TH6骨架作品
    filters:
      and:
        - violence_trauma_priority == "★"
    order:
      - file.link
      - violence_trauma_role
      - violence_trauma_problems
      - violence_trauma_note
      - war_history_stage
      - war_axes
  - type: table
    name: TH6全部作品
    order:
      - file.link
      - violence_trauma_priority
      - violence_trauma_role
      - violence_trauma_problems
      - violence_trauma_note
      - war_history_stage
      - war_axes
