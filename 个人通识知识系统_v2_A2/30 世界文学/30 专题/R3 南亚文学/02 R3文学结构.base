filters:
  and:
    - topic_id == "WL-TOPIC-R3-SOUTH-ASIA"
formulas:
  dimension_zh: if(dimension, dimension.replace("definition", "定义与边界").replace("history", "历史层与连续性").replace("language_media", "语言、文字与媒介").replace("institution", "文学制度与传播").replace("reading_route", "阅读路线").replace("internal_tradition", "内部传统").replace("literary_network", "跨传统网络").replace("mechanism", "形成机制").replace("comparison", "比较").replace("cross_region", "跨区域比较").replace("transmission_mechanism", "传播机制").replace("literary_field", "文学场域").replace("literary_space", "文学空间").replace("field", "文学场域").replace("civilization", "文明传统"), "")
properties:
  file.name:
    displayName: 节点
  note.structure_type_zh:
    displayName: 所属模块
  formula.dimension_zh:
    displayName: 维度
  note.sequence:
    displayName: 顺序
  note.history_position:
    displayName: 节点作用
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部知识节点
    groupBy:
      property: structure_type_zh
      direction: ASC
    order:
      - file.name
      - structure_type_zh
      - formula.dimension_zh
      - sequence
      - history_position
      - id
  - type: table
    name: 核心结构
    filters:
      and:
        - structure_type_zh == "核心结构"
    groupBy:
      property: structure_type_zh
      direction: ASC
    order:
      - file.name
      - structure_type_zh
      - formula.dimension_zh
      - sequence
      - history_position
      - id
  - type: table
    name: 内部传统
    filters:
      and:
        - structure_type_zh == "内部传统"
    groupBy:
      property: structure_type_zh
      direction: ASC
    order:
      - file.name
      - structure_type_zh
      - formula.dimension_zh
      - sequence
      - history_position
      - id
  - type: table
    name: 跨传统网络
    filters:
      and:
        - structure_type_zh == "跨传统网络"
    groupBy:
      property: structure_type_zh
      direction: ASC
    order:
      - file.name
      - structure_type_zh
      - formula.dimension_zh
      - sequence
      - history_position
      - id
