filters:
  and:
    - 'type == "work"'
    - 'topics.contains("WL-TOPIC-Q10-MEMORY")'

properties:
  file.name:
    displayName: "作品"
  note.author:
    displayName: "作者"
  note.read_status:
    displayName: "阅读状态"
  note.topic_links:
    displayName: "专题"
  note.topics:
    displayName: "专题编号"
  note.axis_t:
    displayName: "时间"
  note.axis_r:
    displayName: "地域"
  note.axis_m:
    displayName: "思潮"
  note.axis_g:
    displayName: "类型"
  note.axis_q:
    displayName: "主题"
  note.id:
    displayName: "编号"
  note.memory_priority:
    displayName: "优先级"
  note.memory_dimensions:
    displayName: "机制"
views:
  - type: table
    name: 全部作品
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - memory_priority
      - memory_dimensions
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - 'memory_priority == "★"'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - memory_priority
      - memory_dimensions
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 骨架未读
    filters:
      and:
        - 'memory_priority == "★"'
        - 'read_status == "未读"'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - memory_priority
      - memory_dimensions
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按机制
    groupBy:
      property: memory_dimensions
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - memory_priority
      - memory_dimensions
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 个人记忆
    filters:
      and:
        - 'memory_dimensions.contains("个人记忆")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - memory_priority
      - memory_dimensions
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 家族记忆
    filters:
      and:
        - 'memory_dimensions.contains("家族记忆")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - memory_priority
      - memory_dimensions
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 集体记忆
    filters:
      and:
        - 'memory_dimensions.contains("集体记忆")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - memory_priority
      - memory_dimensions
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 历史创伤
    filters:
      and:
        - 'memory_dimensions.contains("历史创伤")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - memory_priority
      - memory_dimensions
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 遗忘
    filters:
      and:
        - 'memory_dimensions.contains("遗忘")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - memory_priority
      - memory_dimensions
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 历史重写
    filters:
      and:
        - 'memory_dimensions.contains("历史重写")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - memory_priority
      - memory_dimensions
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 代际记忆
    filters:
      and:
        - 'memory_dimensions.contains("代际记忆")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - memory_priority
      - memory_dimensions
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 时间
    filters:
      and:
        - 'memory_dimensions.contains("时间")'
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - memory_priority
      - memory_dimensions
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - memory_priority
      - memory_dimensions
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - memory_priority
      - memory_dimensions
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
