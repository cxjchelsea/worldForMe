filters:
  and:
    - topic_id == "WL-TOPIC-T3-NINETEENTH-CENTURY"
properties:
  file.name:
    displayName: 节点
  note.dimension:
    displayName: 维度
  note.sequence:
    displayName: 顺序
  note.parent:
    displayName: 上级
  note.region:
    displayName: 文学空间
  note.mechanism:
    displayName: 机制
  note.importance:
    displayName: 重要度
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部知识节点
    order:
      - file.name
      - dimension
      - sequence
      - region
      - mechanism
      - importance
      - id
  - type: table
    name: 核心结构
    filters:
      and:
        - dimension != "literary_space"
        - dimension != "mechanism"
    order:
      - sequence
      - file.name
      - dimension
      - importance
  - type: table
    name: 文学体系与空间
    filters:
      and:
        - dimension == "literary_space"
    order:
      - file.name
      - region
      - importance
  - type: table
    name: 生产与传播机制
    filters:
      and:
        - dimension == "mechanism"
    order:
      - file.name
      - mechanism
      - importance
