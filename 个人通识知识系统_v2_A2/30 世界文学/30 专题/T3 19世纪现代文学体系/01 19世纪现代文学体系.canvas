{"nodes":[{"id":"root","type":"file","x":620,"y":0,"width":520,"height":90,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/T3 19世纪现代文学体系/00 19世纪现代文学体系.md"},{"id":"question","type":"text","x":0,"y":0,"width":420,"height":120,"text":"核心问题\n当文学进入市场、报刊、学校、城市和民族国家之后，作者、读者、文类与经典如何发生变化？"},{"id":"system","type":"file","x":620,"y":150,"width":420,"height":80,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/T3 19世纪现代文学体系/10 核心结构/03 现代文学体系如何形成.md"},{"id":"market","type":"file","x":1100,"y":150,"width":420,"height":80,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/T3 19世纪现代文学体系/10 核心结构/04 市场、报刊与职业作者.md"},{"id":"spaces","type":"text","x":120,"y":330,"width":500,"height":210,"text":"六个文学体系与空间\n西欧现代文学市场\n俄国与东欧\n北美与跨大西洋\n拉丁美洲民族文学\n东亚晚近转型\n帝国、殖民与多语言空间"},{"id":"mechanisms","type":"text","x":720,"y":330,"width":500,"height":210,"text":"五种现代文学生产机制\n报刊、连载与大众读者\n职业作者、版权与文学市场\n民族语言、教育与经典建构\n工业城市、阶级与社会问题\n翻译、帝国与跨洋市场"},{"id":"transition","type":"text","x":1320,"y":330,"width":450,"height":210,"text":"核心文学转变\n小说制度中心化\n浪漫主义—现实主义—自然主义重组\n民族文学制度化\n跨国传播扩大\n职业写作与公共文化形成"},{"id":"works","type":"file","x":620,"y":650,"width":460,"height":90,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/T3 19世纪现代文学体系/03 19世纪文学作品.base"},{"id":"reading","type":"file","x":620,"y":800,"width":460,"height":90,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/T3 19世纪现代文学体系/10 核心结构/06 阅读路线.md"},{"id":"compare","type":"file","x":120,"y":650,"width":420,"height":90,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/T3 19世纪现代文学体系/10 核心结构/05 跨区域比较.md"},{"id":"structuredb","type":"file","x":1160,"y":650,"width":420,"height":90,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/T3 19世纪现代文学体系/02 19世纪文学结构.base"},{"id":"previous","type":"file","x":180,"y":980,"width":420,"height":80,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/T2 早期现代文学/00 早期现代文学.md"},{"id":"next","type":"file","x":1120,"y":980,"width":420,"height":80,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/T4 全球现代主义时代/00 全球现代主义时代.md"}],"edges":[{"id":"e1","fromNode":"question","toNode":"root"},{"id":"e2","fromNode":"root","toNode":"system"},{"id":"e3","fromNode":"root","toN