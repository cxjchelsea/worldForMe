filters:
  and:
    - type == "work"
    - qc2_clusters.contains("WL-CN2.1")
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者／归属
  note.read_status:
    displayName: 阅读状态
  note.qc21_priority:
    displayName: 专题优先级
  note.qc21_components:
    displayName: 关联组件
  note.qc21_text_role:
    displayName: 文本角色
  note.qc21_role:
    displayName: 为什么值得看
  note.axis_t:
    displayName: 时间轴
  note.axis_r:
    displayName: 地域／传统
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部作品
    order:
      - file.name
      - author
      - qc21_priority
      - qc21_components
      - qc21_text_role
      - qc21_role
      - read_status
      - axis_t
      - axis_r
      - id
  - type: table
    name: 核心阅读
    filters:
      and:
        - qc21_priority == "★"
    order:
      - file.name
      - qc21_components
      - qc21_text_role
      - read_status
      - id
  - type: table
    name: 扩展阅读
    filters:
      and:
        - qc21_priority == "◆"
    order:
      - file.name
      - qc21_components
      - qc21_text_role
      - read_status
      - id
  - type: table
    name: 已读
    filters:
      and:
        - read_status == "已读"
    order:
      - file.name
      - qc21_priority
      - qc21_components
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status != "已读"
    order:
      - file.name
      - qc21_priority
      - qc21_components
      - id
