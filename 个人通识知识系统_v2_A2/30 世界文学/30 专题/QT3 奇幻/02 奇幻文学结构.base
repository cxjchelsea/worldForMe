filters:
  and:
    - 'topic_id == "WL-TOPIC-G45-FANTASY"'

formulas:
  type_zh: 'type.replace("literature_topic_mechanism", "机制深化").replace("literature_topic_structure", "核心结构").replace("literature_topic_section", "细分").replace("literature_topic_index", "总览").replace("literature_topic_map", "专题")'
  dimension_zh: 'if(dimension, dimension.replace("literary_transformation", "文学转化").replace("trauma_and_transmission", "创伤传递").replace("region_and_retelling", "地域与重述").replace("critical_and_global", "批判与全球").replace("form_and_experience", "形式与经验").replace("memory_scale_system", "记忆尺度").replace("narrative_authority", "叙述权").replace("counter_traditions", "反成长与资格").replace("critical_rewriting", "批判重写").replace("cross_civilization", "跨文明比较").replace("family_and_history", "家族与历史").replace("historical_system", "历史体系").replace("memory_dimensions", "记忆维度").replace("polycentric_world", "多中心世界").replace("trauma_comparison", "创伤比较").replace("unreliable_layers", "失真层次").replace("common_evolution", "共同演进").replace("comparative_axis", "比较维度").replace("critical_history", "批判史").replace("global_modernism", "全球现代主义").replace("love_and_subject", "主体与欲望").replace("memory_dimension", "记忆问题").replace("unreliable_modes", "不可靠机制谱系").replace("cross_tradition", "跨传统").replace("historical_axes", "历史对象").replace("regional_bridge", "地域桥接").replace("regional_system", "区域体系").replace("unreliable_mode", "不可靠机制").replace("modernism_axes", "现代主义横轴").replace("narrative_axes", "叙事横轴").replace("problem_system", "问题谱系").replace("reading_method", "阅读方法").replace("type_mechanism", "类型机制").replace("control_modes", "控制机制").replace("core_question", "核心问题").replace("reading_route", "阅读路线").replace("travel_system", "旅行谱系").replace("memory_scale", "记忆尺度").replace("postwar_axes", "战后横轴").replace("system_model", "系统模型").replace("compare_map", "比较地图").replace("decentering", "去中心").replace("family_axes", "家族横轴").replace("growth_axes", "成长横轴").replace("travel_axes", "旅行横轴").replace("type_system", "类型谱系").replace("comparison", "比较").replace("definition", "定义与边界").replace("latam_axes", "拉美横轴").replace("love_axes", "爱情横轴").replace("technique", "技法").replace("tradition", "传统").replace("boundary", "边界").replace("subgenre", "子类型").replace("war_axes", "战争横轴").replace("bridges", "桥接深化").replace("history", "历史").replace("bridge", "桥接").replace("region", "地域").replace("system", "武人系统").replace("motif", "母题").replace("axes", "内部横轴").replace("mode", "模式"), "")'
  parent_zh: 'if(parent, parent.replace("WL-TOPIC-G43-BILDUNGSROMAN-HISTORY", "历史与思想演进").replace("WL-TOPIC-G45-ADVENTURE-TYPE-SYSTEM", "类型谱系与核心机制").replace("WL-TOPIC-G43-BILDUNGSROMAN-BRIDGE", "成长资格、反成长与跨专题桥接").replace("WL-TOPIC-G43-BILDUNGSROMAN-SYSTEM", "成长谱系与核心机制").replace("WL-TOPIC-G46-DYSTOPIA-TYPE-SYSTEM", "类型谱系与控制机制").replace("WL-TOPIC-G45-FANTASY-TYPE-SYSTEM", "类型谱系与核心机制").replace("WL-TOPIC-M3-MODERNISM-TRADITIONS", "全球现代主义传统").replace("WL-TOPIC-Q10-MEMORY-SCALE-SYSTEM", "记忆尺度与社会叙事").replace("WL-TOPIC-G44-HISTORICAL-HISTORY", "历史小说演进").replace("WL-TOPIC-G45-HORROR-TYPE-SYSTEM", "类型谱系与恐惧机制").replace("WL-TOPIC-G44-HISTORICAL-BRIDGE", "重写历史与跨专题桥接").replace("WL-TOPIC-G44-HISTORICAL-SYSTEM", "历史对象、形式与核心机制").replace("WL-TOPIC-G45-ADVENTURE-BRIDGES", "跨类型桥接、帝国与反冒险").replace("WL-TOPIC-G45-ADVENTURE-HISTORY", "历史演进").replace("WL-TOPIC-Q10-MEMORY-DIMENSIONS", "八种历史、记忆与时间体验").replace("WL-TOPIC-G46-DYSTOPIA-BRIDGES", "Critical Dystopia、全球传统与跨类型桥接").replace("WL-TOPIC-G46-DYSTOPIA-HISTORY", "历史与权力想象演进").replace("WL-TOPIC-G45-FANTASY-BRIDGES", "跨类型、神话与地域桥接").replace("WL-TOPIC-G45-FANTASY-HISTORY", "历史与类型演进").replace("WL-TOPIC-G45-MYSTERY-HISTORY", "历史演进").replace("WL-TOPIC-M3-MODERNISM-BRIDGE", "全球现代主义与跨专题桥接").replace("WL-TOPIC-M3-MODERNISM-SYSTEM", "现代经验与形式机制").replace("WL-TOPIC-G1-MYTH-TRADITIONS", "世界神话传统地图").replace("WL-TOPIC-G43-FAMILY-HISTORY", "历史与谱系演进").replace("WL-TOPIC-G45-HORROR-BRIDGES", "跨类型与全球传统桥接").replace("WL-TOPIC-G45-HORROR-HISTORY", "历史演进").replace("WL-TOPIC-G45-MYSTERY-BRIDGE", "跨类型与地域桥接").replace("WL-TOPIC-G45-MYSTERY-SYSTEM", "类型谱系与核心机制").replace("WL-TOPIC-G45-SF-TYPE-SYSTEM", "类型谱系与核心机制").replace("WL-TOPIC-T5-POSTWAR-HISTORY", "四阶段时间演进").replace("WL-TOPIC-G43-BILDUNGSROMAN", "成长文学").replace("WL-TOPIC-G43-FAMILY-BRIDGE", "Nation、断裂家谱与跨专题桥接").replace("WL-TOPIC-G43-FAMILY-SYSTEM", "家族谱系与核心机制").replace("WL-TOPIC-G7-TRAVEL-HISTORY", "旅行写作史").replace("WL-TOPIC-Q10-MEMORY-BRIDGE", "创伤传递与跨专题桥接").replace("WL-TOPIC-T5-POSTWAR-BRIDGE", "战后问题与跨专题桥接").replace("WL-TOPIC-T5-POSTWAR-SYSTEM", "战后世界体系与多中心结构").replace("WL-TOPIC-G7-TRAVEL-BRIDGE", "观看、帝国与跨专题桥接").replace("WL-TOPIC-G7-TRAVEL-SYSTEM", "旅行谱系与核心机制").replace("WL-TOPIC-Q15-SWASHBUCKLER", "欧洲剑客文学").replace("WL-TOPIC-R6-LATAM-HISTORY", "九阶段文学史").replace("WL-TOPIC-Q2-LOVE-HISTORY", "九阶段爱情文学史").replace("WL-TOPIC-R6-LATAM-BRIDGE", "内部多样性与跨专题桥接").replace("WL-TOPIC-R6-LATAM-SYSTEM", "区域谱系与核心问题").replace("WL-TOPIC-G44-HISTORICAL", "历史文学").replace("WL-TOPIC-G45-SF-BRIDGES", "跨类型与地域桥接").replace("WL-TOPIC-G45-SF-HISTORY", "历史与流派演进").replace("WL-TOPIC-Q2-LOVE-BRIDGE", "主体、欲望与跨文类桥接").replace("WL-TOPIC-Q2-LOVE-SYSTEM", "爱情问题谱系与核心机制").replace("WL-TOPIC-Q6-WAR-HISTORY", "七阶段战争文学思想史").replace("WL-TOPIC-G45-ADVENTURE", "冒险文学").replace("WL-TOPIC-G46-DYSTOPIA", "反乌托邦文学").replace("WL-TOPIC-M3-MODERNISM", "现代主义文学").replace("WL-TOPIC-G45-FANTASY", "奇幻文学").replace("WL-TOPIC-G45-MYSTERY", "推理文学").replace("WL-TOPIC-Q15-COMPARE", "核心比较维度").replace("WL-TOPIC-Q15-SAMURAI", "日本武士与剑豪文学").replace("WL-TOPIC-Q15-SYSTEMS", "五大文明系统、两个角色系统与一条历史分支").replace("WL-TOPIC-Q15-WESTERN", "西部文学").replace("WL-TOPIC-Q6-WAR-AXES", "二十条战争问题横轴").replace("WL-TOPIC-G43-FAMILY", "家族文学").replace("WL-TOPIC-G45-HORROR", "恐怖文学").replace("WL-TOPIC-Q10-MEMORY", "历史、记忆与时间").replace("WL-TOPIC-Q15-GAUCHO", "Gaucho文学").replace("WL-TOPIC-Q15-KNIGHT", "欧洲骑士文学").replace("WL-TOPIC-Q15-OUTLAW", "侠盗文学").replace("WL-TOPIC-Q15-PIRATE", "海盗文学").replace("WL-TOPIC-T5-POSTWAR", "二战后多极文学").replace("WL-TOPIC-G7-TRAVEL", "旅行文学").replace("WL-TOPIC-Q15-WUXIA", "武侠文学").replace("WL-TOPIC-R6-LATAM", "拉丁美洲文学").replace("WL-TOPIC-G1-MYTH", "世界神话文学").replace("WL-TOPIC-Q2-LOVE", "爱情文学").replace("WL-TOPIC-G45-SF", "科幻文学").replace("WL-TOPIC-Q6-WAR", "战争文学").replace("WL-TOPIC-Q15", "世界武人、边疆与法外英雄文学"), "")'
properties:
  file.name:
    displayName: "节点"
  formula.type_zh:
    displayName: "类型"
  formula.dimension_zh:
    displayName: "维度"
  formula.parent_zh:
    displayName: "父节点"
  note.type:
    displayName: "类型"
  note.dimension:
    displayName: "维度"
  note.sequence:
    displayName: "顺序"
  note.parent:
    displayName: "父节点"
  note.history_cluster:
    displayName: "历史位置"
  note.mechanism_cluster:
    displayName: "机制"
  note.id:
    displayName: "编号"
views:
  - type: table
    name: 全部知识节点
    groupBy:
      property: formula.type_zh
      direction: ASC
    order:
      - file.name
      - formula.type_zh
      - formula.dimension_zh
      - sequence
      - formula.parent_zh
      - history_cluster
      - mechanism_cluster
      - id
  - type: table
    name: 核心结构
    filters:
      and:
        - 'type == "literature_topic_structure"'
    order:
      - file.name
      - formula.type_zh
      - formula.dimension_zh
      - sequence
      - formula.parent_zh
      - history_cluster
      - mechanism_cluster
      - id
  - type: table
    name: 细分
    filters:
      and:
        - 'type == "literature_topic_section"'
    order:
      - file.name
      - formula.type_zh
      - formula.dimension_zh
      - sequence
      - formula.parent_zh
      - history_cluster
      - mechanism_cluster
      - id
