filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-G45-FANTASY")
properties:
  file.name:
    displayName: "作品"
  note.author:
    displayName: "作者"
  note.read_status:
    displayName: "阅读状态"
  note.topic_links:
    displayName: "专题"
  note.topics:
    displayName: "专题编号"
  note.axis_t:
    displayName: "时间"
  note.axis_r:
    displayName: "地域"
  note.axis_m:
    displayName: "思潮"
  note.axis_g:
    displayName: "类型"
  note.axis_q:
    displayName: "主题"
  note.id:
    displayName: "编号"
  note.fantasy_priority:
    displayName: "优先级"
  note.fantasy_history_cluster:
    displayName: "历史位置"
  note.fantasy_subgenres:
    displayName: "子类型"
  note.fantasy_region:
    displayName: "地域标签"
views:
  - type: table
    name: 全部作品
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - fantasy_priority
      - fantasy_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - fantasy_priority == "★"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - fantasy_priority
      - fantasy_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 骨架未读
    filters:
      and:
        - fantasy_priority == "★"
        - read_status == "未读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - fantasy_priority
      - fantasy_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - fantasy_priority == "◆"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - fantasy_priority
      - fantasy_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 边界 △
    filters:
      and:
        - fantasy_priority == "△"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - fantasy_priority
      - fantasy_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按历史
    groupBy:
      property: fantasy_history_cluster
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - fantasy_priority
      - fantasy_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - fantasy_priority
      - fantasy_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - fantasy_priority
      - fantasy_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
