filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-TH3-1-GENDER-BODY")
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.gender_body_role:
    displayName: 专题角色
  note.gender_body_priority:
    displayName: 优先级
  note.gender_body_problems:
    displayName: 核心问题
  note.gender_body_note:
    displayName: 专题价值
  note.topic_links:
    displayName: 专题
  note.topics:
    displayName: 专题编号
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 体裁
  note.axis_th:
    displayName: 主题
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部作品
    groupBy:
      property: gender_body_role
      direction: ASC
    order:
      - file.name
      - author
      - gender_body_role
      - gender_body_priority
      - read_status
      - gender_body_problems
      - gender_body_note
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_th
      - id
  - type: table
    name: 骨架作品
    filters:
      and:
        - gender_body_role == "骨架"
    order:
      - file.name
      - author
      - gender_body_priority
      - gender_body_problems
      - gender_body_note
  - type: table
    name: 比较作品
    filters:
      and:
        - gender_body_role == "比较"
    order:
      - file.name
      - author
      - gender_body_problems
      - gender_body_note
  - type: table
    name: 已读
    filters:
      or:
        - read_status == "已读"
        - read_status == "重读"
    order:
      - file.name
      - author
      - gender_body_role
      - gender_body_problems
