filters:
  and:
    - file.path.startsWith("个人通识知识系统_v2_A2/30 世界文学/40 作品/")
    - topics.contains("WL-TOPIC-TH5-POWER-INSTITUTIONS-ORDER")
views:
  - type: table
    name: 核心作品
    filters:
      and:
        - power_order_priority == "★"
    order:
      - file.link
      - power_order_role
      - power_order_problems
      - power_order_note
  - type: table
    name: 全部作品
    order:
      - file.link
      - power_order_priority
      - power_order_role
      - power_order_problems
      - power_order_note
