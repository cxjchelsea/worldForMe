filters:
  and:
    - topic_id == "WL-TOPIC-QT811"
properties:
  file.name:
    displayName: 节点
  note.type:
    displayName: 类型
  note.dimension:
    displayName: 维度
  note.sequence:
    displayName: 顺序
views:
  - type: table
    name: 全部结构节点
    order:
      - sequence
      - file.name
      - type
      - dimension
  - type: table
    name: 核心结构
    filters:
      and:
        - 'type == "literature_topic_structure"'
        - 'sequence < 20'
    order:
      - sequence
      - file.name
  - type: table
    name: QT8.2 叙事组件与关系
    filters:
      and:
        - 'sequence >= 20'
        - 'sequence < 30'
    order:
      - sequence
      - file.name
      - dimension
  - type: table
    name: 后世传播与阅读
    filters:
      and:
        - 'sequence >= 30'
        - 'sequence < 40'
    order:
      - sequence
      - file.name
      - dimension
