filters:
  and:
    - topic_id == "WL-TOPIC-QT811"
    - type == "literature_topic_text_reference"
properties:
  file.name:
    displayName: 文本关系记录
  note.canonical_title:
    displayName: 文本
  note.tradition_role:
    displayName: 传统角色
  note.period:
    displayName: 时段
  note.canonical_work:
    displayName: 主作品节点
  note.source_status:
    displayName: 状态
  note.sequence:
    displayName: 顺序
views:
  - type: table
    name: 文本实体关系
    groupBy:
      property: tradition_role
      direction: ASC
    order:
      - sequence
      - canonical_title
      - period
      - canonical_work
      - source_status
