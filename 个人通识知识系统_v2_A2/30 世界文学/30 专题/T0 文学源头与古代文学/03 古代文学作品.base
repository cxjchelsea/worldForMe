filters:
  and:
    - type == "work"
    - axis_t.contains("T0 文学源头与古代文学")
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.topics:
    displayName: 专题编号
  note.t0_priority:
    displayName: 优先级
  note.t0_history_position:
    displayName: 历史位置
  note.t0_stage:
    displayName: 内部分期
  note.t0_historical_role:
    displayName: 历史角色
  note.t0_role:
    displayName: 形成机制
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 类型
  note.axis_q:
    displayName: 主题
  note.id:
    displayName: 编号
  note.verification_status:
    displayName: 校验状态
views:
  - type: table
    name: 全部 T0 作品
    order:
      - file.name
      - author
      - read_status
      - t0_priority
      - t0_history_position
      - t0_stage
      - t0_historical_role
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
    columnSize:
      file.name: 173
  - type: table
    name: 核心 ★
    filters:
      and:
        - t0_priority == "★"
    order:
      - file.name
      - author
      - read_status
      - t0_priority
      - t0_history_position
      - t0_stage
      - t0_historical_role
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 重点 ◆
    filters:
      and:
        - t0_priority == "◆"
    order:
      - file.name
      - author
      - read_status
      - t0_priority
      - t0_history_position
      - t0_stage
      - t0_historical_role
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 扩展 △
    filters:
      and:
        - t0_priority == "△"
    order:
      - file.name
      - author
      - read_status
      - t0_priority
      - t0_history_position
      - t0_stage
      - t0_historical_role
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - read_status
      - t0_priority
      - t0_history_position
      - t0_stage
      - t0_historical_role
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - read_status
      - t0_priority
      - t0_history_position
      - t0_stage
      - t0_historical_role
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按历史位置
    groupBy:
      property: t0_history_position
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - t0_priority
      - t0_history_position
      - t0_stage
      - t0_historical_role
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按地域
    groupBy:
      property: axis_r
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - t0_priority
      - t0_history_position
      - t0_stage
      - t0_historical_role
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按思潮
    groupBy:
      property: axis_m
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - t0_priority
      - t0_history_position
      - t0_stage
      - t0_historical_role
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按类型
    groupBy:
      property: axis_g
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - t0_priority
      - t0_history_position
      - t0_stage
      - t0_historical_role
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按主题
    groupBy:
      property: axis_q
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - t0_priority
      - t0_history_position
      - t0_stage
      - t0_historical_role
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 待校验
    filters:
      and:
        - verification_status != "自动通过"
        - verification_status != "手工核验"
    order:
      - file.name
      - author
      - verification_status
      - t0_priority
      - t0_history_position
      - t0_stage
      - t0_historical_role
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
