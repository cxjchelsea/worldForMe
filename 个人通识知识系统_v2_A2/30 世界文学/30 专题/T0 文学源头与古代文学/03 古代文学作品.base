filters:
  and:
    - type == "work"
    - axis_t.contains("T0 文学源头与古代文学")
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.topics:
    displayName: 专题
  note.t0_priority:
    displayName: 优先级
  note.t0_civilization:
    displayName: 历史位置
  note.t0_role:
    displayName: 机制
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 类型
  note.axis_q:
    displayName: 主题
  note.id:
    displayName: 编号
  note.verification_status:
    displayName: 校验状态
views:
  - type: table
    name: 全部 T0 作品
    order:
      - file.name
      - author
      - read_status
      - topics
      - t0_priority
      - t0_civilization
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
    columnSize:
      file.name: 173
  - type: table
    name: T0 骨架路线
    filters:
      and:
        - or:
            - file.name == "吉尔伽美什史诗"
            - file.name == "埃努玛·埃利什"
            - file.name == "埃及亡灵书"
            - file.name == "创世记"
            - file.name == "约伯记"
            - file.name == "伊利亚特"
            - file.name == "奥德赛"
            - file.name == "俄狄浦斯王"
            - file.name == "埃涅阿斯纪"
            - file.name == "变形记"
            - file.name == "梨俱吠陀"
            - file.name == "摩诃婆罗多"
            - file.name == "罗摩衍那"
            - file.name == "诗经"
            - file.name == "楚辞"
            - file.name == "史记"
            - file.name == "左传"
    order:
      - file.name
      - author
      - read_status
      - topics
      - t0_priority
      - t0_civilization
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: T0 理解扩展 ◆
    filters:
      and:
        - t0_priority == "◆"
    order:
      - file.name
      - author
      - read_status
      - topics
      - t0_priority
      - t0_civilization
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - read_status
      - topics
      - t0_priority
      - t0_civilization
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - read_status
      - topics
      - t0_priority
      - t0_civilization
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按地域
    groupBy:
      property: axis_r
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topics
      - t0_priority
      - t0_civilization
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按类型
    groupBy:
      property: axis_g
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topics
      - t0_priority
      - t0_civilization
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 待校验
    filters:
      and:
        - verification_status != "自动通过"
        - verification_status != "手工核验"
    order:
      - file.name
      - author
      - verification_status
      - topics
      - t0_priority
      - t0_civilization
      - t0_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
