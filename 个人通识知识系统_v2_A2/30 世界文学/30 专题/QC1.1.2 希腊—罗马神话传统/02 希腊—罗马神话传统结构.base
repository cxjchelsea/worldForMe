filters:
  and:
    - topic_id == "WL-TOPIC-QC112"
formulas:
  dimension_zh: if(dimension, dimension.replace("boundary", "定义与边界").replace("definition", "定义与边界").replace("context", "历史文化环境").replace("history", "历史层与连续性").replace("worldview", "世界观与宇宙结构").replace("actors", "人物与超自然存在").replace("narrative_cycle", "核心叙事循环").replace("oral_ritual", "口传、仪式与表演").replace("textualization", "书写、编纂与经典化").replace("evolution", "内部演变").replace("text_lineage", "文本谱系").replace("source_witness", "源文本与早期见证").replace("canon", "定型文本与核心经典").replace("reading_route", "阅读路线").replace("motif_mapping", "母题映射").replace("transmission", "传播、借用与结构相似").replace("reception", "后世传播").replace("bridge", "专题桥接").replace("bibliography", "支撑研究书目"), "")
properties:
  file.name:
    displayName: 节点
  note.structure_type_zh:
    displayName: 所属模块
  formula.dimension_zh:
    displayName: 维度
  note.sequence:
    displayName: 顺序
  note.history_position:
    displayName: 节点作用
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部知识节点
    groupBy:
      property: structure_type_zh
      direction: ASC
    order:
      - file.name
      - structure_type_zh
      - formula.dimension_zh
      - sequence
      - history_position
      - id
  - type: table
    name: 核心结构
    filters:
      and:
        - structure_type_zh == "核心结构"
    groupBy:
      property: structure_type_zh
      direction: ASC
    order:
      - file.name
      - structure_type_zh
      - formula.dimension_zh
      - sequence
      - history_position
      - id
  - type: table
    name: 内部文本与传统
    filters:
      and:
        - structure_type_zh == "内部文本与传统"
    groupBy:
      property: structure_type_zh
      direction: ASC
    order:
      - file.name
      - structure_type_zh
      - formula.dimension_zh
      - sequence
      - history_position
      - id
  - type: table
    name: 母题与跨文化关系
    filters:
      and:
        - structure_type_zh == "母题与跨文化关系"
    groupBy:
      property: structure_type_zh
      direction: ASC
    order:
      - file.name
      - structure_type_zh
      - formula.dimension_zh
      - sequence
      - history_position
      - id
  - type: table
    name: 后世传播与阅读
    filters:
      and:
        - structure_type_zh == "后世传播与阅读"
    groupBy:
      property: structure_type_zh
      direction: ASC
    order:
      - file.name
      - structure_type_zh
      - formula.dimension_zh
      - sequence
      - history_position
      - id
