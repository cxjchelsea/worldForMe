filters:
  and:
    - topic_id == "WL-TOPIC-QC112"
    - structure_type_zh != null
formulas:
  dimension_zh: if(dimension, dimension.replace("research_bibliography", "支撑研究书目").replace("qc2_component_mapping", "叙事组件映射").replace("oral_ritual_performance", "口传、仪式与表演").replace("internal_evolution", "内部演变").replace("historical_context", "历史文化环境").replace("narrative_cycles", "核心叙事循环").replace("transmission_confidence", "传播、借用与结构相似").replace("source_witness", "源文本与早期见证").replace("reading_entry", "谱系阅读入口").replace("reading_route", "阅读路线").replace("text_lineage", "文本谱系").replace("actor_system", "人物与超自然存在").replace("qc2_mapping", "QC2 叙事组件映射").replace("textualization", "书写、编纂与经典化").replace("definition", "专题定位").replace("boundary", "定义与边界").replace("cosmology", "世界观与宇宙结构").replace("afterlife", "后世文学与文化传播").replace("reception", "后世接受").replace("bridges", "专题桥接").replace("canon", "定型文本与核心经典"), "")
properties:
  file.name:
    displayName: 节点
  note.structure_type_zh:
    displayName: 所属模块
  formula.dimension_zh:
    displayName: 维度
  note.sequence:
    displayName: 顺序
  note.history_position:
    displayName: 节点作用
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部知识节点
    groupBy:
      property: structure_type_zh
      direction: ASC
    order:
      - file.name
      - structure_type_zh
      - formula.dimension_zh
      - sequence
      - history_position
      - id
  - type: table
    name: 传统本体与形成结构
    filters:
      and:
        - structure_type_zh == "传统本体与形成结构"
    groupBy:
      property: structure_type_zh
      direction: ASC
    order:
      - file.name
      - structure_type_zh
      - formula.dimension_zh
      - sequence
      - history_position
      - id
  - type: table
    name: 文本见证与内部演变
    filters:
      and:
        - structure_type_zh == "文本见证与内部演变"
    groupBy:
      property: structure_type_zh
      direction: ASC
    order:
      - file.name
      - structure_type_zh
      - formula.dimension_zh
      - sequence
      - history_position
      - id
  - type: table
    name: 叙事组件与跨文化关系
    filters:
      and:
        - structure_type_zh == "叙事组件与跨文化关系"
    groupBy:
      property: structure_type_zh
      direction: ASC
    order:
      - file.name
      - structure_type_zh
      - formula.dimension_zh
      - sequence
      - history_position
      - id
  - type: table
    name: 后世接受与阅读
    filters:
      and:
        - structure_type_zh == "后世接受与阅读"
    groupBy:
      property: structure_type_zh
      direction: ASC
    order:
      - file.name
      - structure_type_zh
      - formula.dimension_zh
      - sequence
      - history_position
      - id
