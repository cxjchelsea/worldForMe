filters:
  and:
    - topic_id == "WL-TOPIC-QC112"
formulas:
  module_zh: if(file.folder == "个人通识知识系统_v2_A2/30 世界文学/30 专题/QC1.1.2 希腊—罗马神话传统/10 传统本体与形成结构", "传统本体与形成结构", if(file.folder == "个人通识知识系统_v2_A2/30 世界文学/30 专题/QC1.1.2 希腊—罗马神话传统/11 文本见证与内部演变", "文本见证与内部演变", if(file.folder == "个人通识知识系统_v2_A2/30 世界文学/30 专题/QC1.1.2 希腊—罗马神话传统/12 叙事组件与跨文化关系", "叙事组件与跨文化关系", if(file.folder == "个人通识知识系统_v2_A2/30 世界文学/30 专题/QC1.1.2 希腊—罗马神话传统/13 后世接受与阅读", "后世接受与阅读", "其他"))))
  dimension_zh: if(dimension, dimension.replace("boundary", "定义与边界").replace("definition", "定义与边界").replace("context", "历史文化环境").replace("history", "历史层与连续性").replace("worldview", "世界观与宇宙结构").replace("actors", "人物与超自然存在").replace("narrative_cycle", "核心叙事循环").replace("oral_ritual", "口传、仪式与表演").replace("textualization", "书写、编纂与经典化").replace("evolution", "内部演变").replace("text_lineage", "文本谱系").replace("source_witness", "源文本与早期见证").replace("canon", "定型文本与核心经典").replace("reading_route", "阅读路线").replace("motif_mapping", "叙事组件映射").replace("qc2_mapping", "QC2 叙事组件映射").replace("transmission", "传播、借用与结构相似").replace("reception", "后世接受").replace("bridge", "专题桥接").replace("bibliography", "支撑研究书目"), "")
  history_zh: if(history_position, history_position, "—")
properties:
  file.name:
    displayName: 节点
  formula.module_zh:
    displayName: 所属模块
  formula.dimension_zh:
    displayName: 维度
  note.sequence:
    displayName: 顺序
  formula.history_zh:
    displayName: 节点作用
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部知识节点
    groupBy:
      property: formula.module_zh
      direction: ASC
    order: [file.name, formula.module_zh, formula.dimension_zh, sequence, formula.history_zh, id]
  - type: table
    name: 传统本体与形成结构
    filters:
      and:
        - file.folder == "个人通识知识系统_v2_A2/30 世界文学/30 专题/QC1.1.2 希腊—罗马神话传统/10 传统本体与形成结构"
    order: [file.name, formula.module_zh, formula.dimension_zh, sequence, formula.history_zh, id]
  - type: table
    name: 文本见证与内部演变
    filters:
      and:
        - file.folder == "个人通识知识系统_v2_A2/30 世界文学/30 专题/QC1.1.2 希腊—罗马神话传统/11 文本见证与内部演变"
    order: [file.name, formula.module_zh, formula.dimension_zh, sequence, formula.history_zh, id]
  - type: table
    name: 叙事组件与跨文化关系
    filters:
      and:
        - file.folder == "个人通识知识系统_v2_A2/30 世界文学/30 专题/QC1.1.2 希腊—罗马神话传统/12 叙事组件与跨文化关系"
    order: [file.name, formula.module_zh, formula.dimension_zh, sequence, formula.history_zh, id]
  - type: table
    name: 后世接受与阅读
    filters:
      and:
        - file.folder == "个人通识知识系统_v2_A2/30 世界文学/30 专题/QC1.1.2 希腊—罗马神话传统/13 后世接受与阅读"
    order: [file.name, formula.module_zh, formula.dimension_zh, sequence, formula.history_zh, id]
