filters:
  and:
    - type == "work"
    - qc112_priority != null
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.qc112_priority:
    displayName: 优先级
  note.qc112_internal_tradition:
    displayName: 内部传统
  note.qc112_tradition_stage:
    displayName: 传统阶段
  note.qc112_role:
    displayName: 专题角色
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 类型
  note.axis_q:
    displayName: 主题
  note.verification_status:
    displayName: 校验状态
views:
  - type: table
    name: 全部 QC1.1.2 作品
    order: [file.name, author, read_status, qc112_priority, qc112_internal_tradition, qc112_tradition_stage, qc112_role]
  - type: table
    name: 核心 ★
    filters:
      and:
        - qc112_priority == "★"
    order: [file.name, author, read_status, qc112_internal_tradition, qc112_role]
  - type: table
    name: 重点 ◆
    filters:
      and:
        - qc112_priority == "◆"
    order: [file.name, author, read_status, qc112_internal_tradition, qc112_role]
  - type: table
    name: 扩展 △
    filters:
      and:
        - qc112_priority == "△"
    order: [file.name, author, read_status, qc112_internal_tradition, qc112_role]
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order: [file.name, qc112_priority, qc112_internal_tradition]
  - type: table
    name: 已读
    filters:
      or:
        - read_status == "已读"
        - read_status == "重读"
    order: [file.name, qc112_priority, qc112_internal_tradition]
  - type: table
    name: 按内部传统
    groupBy:
      property: qc112_internal_tradition
      direction: ASC
    order: [file.name, qc112_priority, qc112_tradition_stage, qc112_role]
  - type: table
    name: 按传统阶段
    groupBy:
      property: qc112_tradition_stage
      direction: ASC
    order: [file.name, qc112_priority, qc112_internal_tradition, qc112_role]
  - type: table
    name: 按专题角色
    groupBy:
      property: qc112_role
      direction: ASC
    order: [file.name, qc112_priority, qc112_internal_tradition]
