filters:
  and:
    - type == "work"
    - or:
        - title == "伊利亚特"
        - title == "奥德赛"
        - title == "神谱"
        - title == "工作与时日"
        - title == "俄狄浦斯王"
        - title == "俄瑞斯忒亚"
        - title == "埃涅阿斯纪"
        - title == "变形记"
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.myth_priority:
    displayName: 全局神话优先级
  note.r1_tradition:
    displayName: 地域传统
  note.t0_stage:
    displayName: 历史阶段
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 类型
  note.axis_q:
    displayName: 主题
views:
  - type: table
    name: 全部核心文本
    order: [file.name, author, read_status, myth_priority, r1_tradition, t0_stage]
  - type: table
    name: 核心 ★
    filters:
      and:
        - myth_priority == "★"
    order: [file.name, author, read_status]
  - type: table
    name: 重点 ◆
    filters:
      and:
        - myth_priority == "◆"
    order: [file.name, author, read_status]
  - type: table
    name: 扩展 △
    filters:
      and:
        - myth_priority == "△"
    order: [file.name, author, read_status]
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order: [file.name, author, myth_priority]
  - type: table
    name: 已读
    filters:
      or:
        - read_status == "已读"
        - read_status == "重读"
    order: [file.name, author, myth_priority]
