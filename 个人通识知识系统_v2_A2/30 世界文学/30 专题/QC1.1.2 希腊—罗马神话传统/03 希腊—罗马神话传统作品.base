filters:
  and:
    - type == "work"
    - file.folder == "个人通识知识系统_v2_A2/30 世界文学/40 作品"
    - or:
        - qc112_priority == "★"
        - qc112_priority == "◆"
        - qc112_priority == "△"
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.qc112_priority:
    displayName: 优先级
  note.qc112_internal_tradition:
    displayName: 内部传统
  note.qc112_tradition_stage:
    displayName: 传统阶段
  note.qc112_text_role:
    displayName: 文本谱系角色
  note.qc112_role:
    displayName: 专题认知角色
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 类型
  note.axis_q:
    displayName: 主题
  note.id:
    displayName: 编号
  note.verification_status:
    displayName: 校验状态
views:
  - type: table
    name: 全部 QC1.1.2 作品
    order: [file.name, author, read_status, qc112_priority, qc112_internal_tradition, qc112_tradition_stage, qc112_text_role, qc112_role, axis_t, axis_r, axis_m, axis_g, axis_q, id, verification_status]
  - type: table
    name: 核心 ★
    filters:
      and:
        - qc112_priority == "★"
    order: [file.name, author, read_status, qc112_text_role, qc112_internal_tradition, qc112_role]
  - type: table
    name: 重点 ◆
    filters:
      and:
        - qc112_priority == "◆"
    order: [file.name, author, read_status, qc112_text_role, qc112_internal_tradition, qc112_role]
  - type: table
    name: 扩展 △
    filters:
      and:
        - qc112_priority == "△"
    order: [file.name, author, read_status, qc112_text_role, qc112_internal_tradition, qc112_role]
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order: [file.name, qc112_priority, qc112_text_role, qc112_internal_tradition]
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order: [file.name, qc112_priority, qc112_text_role, qc112_internal_tradition]
  - type: table
    name: 按内部传统
    groupBy:
      property: qc112_internal_tradition
      direction: ASC
    order: [file.name, qc112_priority, qc112_tradition_stage, qc112_text_role, qc112_role]
  - type: table
    name: 按传统阶段
    groupBy:
      property: qc112_tradition_stage
      direction: ASC
    order: [file.name, qc112_priority, qc112_internal_tradition, qc112_text_role, qc112_role]
  - type: table
    name: 按文本谱系角色
    groupBy:
      property: qc112_text_role
      direction: ASC
    order: [file.name, qc112_priority, qc112_internal_tradition, qc112_tradition_stage, qc112_role]
  - type: table
    name: 按专题认知角色
    groupBy:
      property: qc112_role
      direction: ASC
    order: [file.name, qc112_priority, qc112_text_role, qc112_internal_tradition]
  - type: table
    name: 按时间
    groupBy:
      property: axis_t
      direction: ASC
    order: [file.name, qc112_priority, qc112_text_role, qc112_internal_tradition, qc112_role]
  - type: table
    name: 按地域
    groupBy:
      property: axis_r
      direction: ASC
    order: [file.name, qc112_priority, qc112_text_role, qc112_internal_tradition, qc112_role]
  - type: table
    name: 按思潮
    groupBy:
      property: axis_m
      direction: ASC
    order: [file.name, qc112_priority, qc112_text_role, qc112_internal_tradition, qc112_role]
  - type: table
    name: 按类型
    groupBy:
      property: axis_g
      direction: ASC
    order: [file.name, qc112_priority, qc112_text_role, qc112_internal_tradition, qc112_role]
  - type: table
    name: 按主题
    groupBy:
      property: axis_q
      direction: ASC
    order: [file.name, qc112_priority, qc112_text_role, qc112_internal_tradition, qc112_role]
  - type: table
    name: 待校验
    filters:
      and:
        - verification_status != "自动通过"
        - verification_status != "手工核验"
    order: [file.name, qc112_priority, qc112_text_role, qc112_internal_tradition, verification_status]
