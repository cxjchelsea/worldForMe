filters:
  and:
    - type == "qc3_model_input"
    - model_id == "WL-QC31-MODEL-KNIGHT"
properties:
  file.name:
    displayName: 输入对象
  note.input_layer:
    displayName: 输入层
  note.input_name:
    displayName: 输入名称
  note.role:
    displayName: 模型角色
  note.confidence:
    displayName: 置信度
views:
  - type: table
    name: 全部输入
    order:
      - file.name
      - input_layer
      - input_name
      - role
      - confidence
  - type: table
    name: QC1输入
    filters:
      or:
        - input_layer == "QC1.1"
        - input_layer == "QC1.2"
    order:
      - file.name
      - input_layer
      - role
      - confidence
  - type: table
    name: QC2输入
    filters:
      and:
        - input_layer == "QC2"
    order:
      - file.name
      - role
      - confidence
  - type: table
    name: 历史条件
    filters:
      and:
        - input_layer == "HISTORY"
    order:
      - file.name
      - role
      - confidence
