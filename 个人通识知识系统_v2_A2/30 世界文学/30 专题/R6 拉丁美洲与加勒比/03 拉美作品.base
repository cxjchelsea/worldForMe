filters:
  and:
    - type == "work"
    - axis_r.contains("R6 拉丁美洲与加勒比")
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.r6_priority:
    displayName: 优先级
  note.r6_tradition:
    displayName: 内部传统
  note.r6_tradition_stage:
    displayName: 传统阶段
  note.r6_role:
    displayName: 传统角色
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 类型
  note.axis_q:
    displayName: 主题
  note.id:
    displayName: 编号
  note.verification_status:
    displayName: 校验状态
views:
  - type: table
    name: 全部 R6 作品
    order:
      - file.name
      - author
      - read_status
      - r6_priority
      - r6_tradition
      - r6_tradition_stage
      - r6_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
      - verification_status
  - type: table
    name: 核心 ★
    filters:
      and:
        - r6_priority == "★"
    order:
      - file.name
      - author
      - read_status
      - r6_priority
      - r6_tradition
      - r6_tradition_stage
      - r6_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
      - verification_status
  - type: table
    name: 重点 ◆
    filters:
      and:
        - r6_priority == "◆"
    order:
      - file.name
      - author
      - read_status
      - r6_priority
      - r6_tradition
      - r6_tradition_stage
      - r6_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
      - verification_status
  - type: table
    name: 扩展 △
    filters:
      and:
        - r6_priority == "△"
    order:
      - file.name
      - author
      - read_status
      - r6_priority
      - r6_tradition
      - r6_tradition_stage
      - r6_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
      - verification_status
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - read_status
      - r6_priority
      - r6_tradition
      - r6_tradition_stage
      - r6_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
      - verification_status
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - read_status
      - r6_priority
      - r6_tradition
      - r6_tradition_stage
      - r6_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
      - verification_status
  - type: table
    name: 按内部传统
    filters:
      and:
        - r6_tradition != null
    groupBy:
      property: r6_tradition
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - r6_priority
      - r6_tradition
      - r6_tradition_stage
      - r6_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
      - verification_status
  - type: table
    name: 按时间
    groupBy:
      property: axis_t
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - r6_priority
      - r6_tradition
      - r6_tradition_stage
      - r6_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
      - verification_status
  - type: table
    name: 按思潮
    groupBy:
      property: axis_m
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - r6_priority
      - r6_tradition
      - r6_tradition_stage
      - r6_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
      - verification_status
  - type: table
    name: 按类型
    groupBy:
      property: axis_g
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - r6_priority
      - r6_tradition
      - r6_tradition_stage
      - r6_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
      - verification_status
  - type: table
    name: 按主题
    groupBy:
      property: axis_q
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - r6_priority
      - r6_tradition
      - r6_tradition_stage
      - r6_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
      - verification_status
  - type: table
    name: 待传统归类
    filters:
      or:
        - r6_tradition == null
        - r6_tradition.contains("待校准")
    order:
      - file.name
      - author
      - read_status
      - r6_priority
      - r6_tradition
      - r6_tradition_stage
      - r6_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
      - verification_status
  - type: table
    name: 待校验
    filters:
      and:
        - verification_status != "自动通过"
        - verification_status != "手工核验"
    order:
      - file.name
      - author
      - read_status
      - r6_priority
      - r6_tradition
      - r6_tradition_stage
      - r6_role
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
      - verification_status
