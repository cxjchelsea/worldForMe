filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-TH3-5-MIGRATION-EXILE")
properties:
  file.name: {displayName: 作品}
  note.author: {displayName: 作者}
  note.read_status: {displayName: 阅读状态}
  note.migration_exile_priority: {displayName: 优先级}
  note.migration_exile_role: {displayName: 专题角色}
  note.migration_exile_problems: {displayName: 核心问题}
  note.migration_exile_note: {displayName: 专题价值}
  note.axis_t: {displayName: 时间}
  note.axis_r: {displayName: 地域}
  note.axis_m: {displayName: 思潮}
  note.axis_g: {displayName: 体裁}
  note.axis_th: {displayName: 主题}
  note.id: {displayName: 编号}
views:
  - type: table
    name: 核心 ★
    filters: {and: [migration_exile_priority == "★"]}
    order: [file.name, author, read_status, migration_exile_role, migration_exile_problems, migration_exile_note, axis_t, axis_r, axis_m, axis_g, axis_th]
  - type: table
    name: 重点 ◆
    filters: {and: [migration_exile_priority == "◆"]}
    order: [file.name, author, read_status, migration_exile_role, migration_exile_problems, migration_exile_note]
  - type: table
    name: 扩展 △
    filters: {and: [migration_exile_priority == "△"]}
    order: [file.name, author, read_status, migration_exile_role, migration_exile_problems, migration_exile_note]
  - type: table
    name: 已读
    filters: {or: [read_status == "已读", read_status == "重读"]}
    order: [file.name, author, migration_exile_priority, migration_exile_role, migration_exile_problems, axis_t, axis_r, axis_m, axis_g]
  - type: table
    name: 未读
    filters: {and: [read_status == "未读"]}
    order: [file.name, author, migration_exile_priority, migration_exile_role, migration_exile_problems, axis_t, axis_r, axis_m, axis_g]
  - type: table
    name: 全部作品
    order: [file.name, author, migration_exile_priority, migration_exile_role, read_status, migration_exile_problems, migration_exile_note, axis_t, axis_r, axis_m, axis_g, axis_th, id]
