filters:
  and:
    - type == "work"
    - file.folder == "个人通识知识系统_v2_A2/30 世界文学/40 作品"
    - or:
        - qc124_priority == "★"
        - qc124_priority == "◆"
        - qc124_priority == "△"
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.qc124_priority:
    displayName: 优先级
  note.qc124_stage:
    displayName: 传播阶段
  note.qc124_text_role:
    displayName: 文本角色
  note.qc124_role:
    displayName: 专题角色
  note.qc124_source_layer:
    displayName: 来源层
  note.qc124_collection_scope:
    displayName: 集合范围
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 类型
  note.axis_q:
    displayName: 主题
  note.id:
    displayName: 编号
  note.verification_status:
    displayName: 校验状态
views:
  - type: table
    name: 全部 QC1.2.4 作品
    order:
      - file.name
      - author
      - read_status
      - qc124_priority
      - qc124_stage
      - qc124_text_role
      - qc124_role
      - qc124_source_layer
      - qc124_collection_scope
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
      - verification_status
  - type: table
    name: 核心 ★
    filters:
      and:
        - qc124_priority == "★"
    order:
      - file.name
      - author
      - qc124_stage
      - qc124_text_role
      - qc124_role
      - qc124_source_layer
  - type: table
    name: 重点 ◆
    filters:
      and:
        - qc124_priority == "◆"
    order:
      - file.name
      - author
      - qc124_stage
      - qc124_text_role
      - qc124_role
  - type: table
    name: 扩展 △
    filters:
      and:
        - qc124_priority == "△"
    order:
      - file.name
      - author
      - qc124_stage
      - qc124_text_role
      - qc124_role
  - type: table
    name: 按传播阶段
    groupBy:
      property: qc124_stage
      direction: ASC
    order:
      - file.name
      - qc124_priority
      - qc124_text_role
      - qc124_role
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - qc124_priority
      - qc124_stage
      - qc124_text_role
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - qc124_priority
      - qc124_stage
      - qc124_text_role
  - type: table
    name: 待校验
    filters:
      and:
        - verification_status != "自动通过"
        - verification_status != "手工核验"
    order:
      - file.name
      - qc124_priority
      - qc124_stage
      - qc124_text_role
      - verification_status
