{"nodes":[{"id":"source","type":"text","text":"来源环境\nQC1.1.9 伊斯兰—波斯叙事传统\n+ 更早跨文化叙事资源","x":0,"y":0,"width":300,"height":140},{"id":"frame","type":"text","text":"框架叙事\n山鲁佐德／国王\ncollection identity 的重要组织机制","x":400,"y":0,"width":300,"height":140},{"id":"arabic","type":"text","text":"阿拉伯语手稿传统\n多个 manuscript family / recension\n不存在单一固定目录","x":800,"y":0,"width":320,"height":160},{"id":"syrian","type":"text","text":"叙利亚系／加朗所据手稿见证\n较早长篇 collection witness","x":800,"y":260,"width":320,"height":140},{"id":"egyptian","type":"text","text":"后期埃及 recension\n后续阿拉伯印本的重要版本层","x":800,"y":480,"width":320,"height":140},{"id":"membership","type":"text","text":"story_membership\ncore_attested / branch_attested / translation_added / later_print_added / uncertain","x":1220,"y":120,"width":360,"height":180},{"id":"galland","type":"text","text":"加朗法译\ntranslation_layer + editorial_recomposition\n欧洲传播的结构性转折","x":1220,"y":380,"width":340,"height":160},{"id":"diyab","type":"text","text":"迪亚布等来源层\noral / written / translator source layer\n解释新增成员进入路径","x":1220,"y":620,"width":340,"height":160},{"id":"print","type":"text","text":"19世纪阿拉伯印本与全球译本\n印刷固定某些集合形态\n继续发生选编与重组","x":1660,"y":380,"width":340,"height":160},{"id":"qc2","type":"text","text":"QC2 接口\n框架叙事／嵌套叙事／延宕／机智／命运逆转／奇遇等","x":1660,"y":80,"width":340,"height":160},{"id":"warning","type":"text","text":"证据警告\n现代常见 ≠ 早期必有\n译本收录 ≠ 全部阿拉伯手稿收录\n后期完整目录 ≠ 原始固定目录","x":1660,"y":650,"width":360,"height":180}],"edges":[{"id":"e1","fromNode":"source","toNode":"frame","label":"来源环境／形成背景"},{"id":"e2","fromNode":"frame","toNode":"arabic","label":"组织集合身份"},{"id":"e3","fromNode":"arabic","toNode":"syrian","label":"attested in / family witness"},{"id":"e4","fromNode":"arabic","toNode":"egyptian","label":"later recension"},{"id":"e5","fromNode":"syrian","toNode":"membership","label":"成员见证"},{"id":"e6","fromNode":"egyptian","toNode":"membership","label":"成员见证"},{"id":"e7","fromNode":"syrian","toNode":"galland","label":"source witness"},{"id":"e8","fromNode":"diyab"