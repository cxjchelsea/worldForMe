filters:
  and:
    - topic_id == "WL-TOPIC-QC121"
    - structure_type_zh != null
properties:
  file.name:
    displayName: 页面
  note.structure_type_zh:
    displayName: 所属模块
  note.dimension:
    displayName: 维度
  note.sequence:
    displayName: 顺序
  note.history_position:
    displayName: 历史位置
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部结构
    order: [file.name, structure_type_zh, dimension, sequence, history_position, id]
  - type: table
    name: 定义、边界与叙事核
    filters:
      and:
        - structure_type_zh == "定义、边界与叙事核"
    order: [file.name, dimension, sequence, history_position]
  - type: table
    name: 早期见证与史诗循环
    filters:
      and:
        - structure_type_zh == "早期见证与史诗循环"
    order: [file.name, dimension, sequence, history_position]
  - type: table
    name: 文本谱系与版本分支
    filters:
      and:
        - structure_type_zh == "文本谱系与版本分支"
    order: [file.name, dimension, sequence, history_position]
  - type: table
    name: 人物结构与关键变体
    filters:
      and:
        - structure_type_zh == "人物结构与关键变体"
    order: [file.name, dimension, sequence, history_position]
  - type: table
    name: 跨语言重写与后世生命
    filters:
      and:
        - structure_type_zh == "跨语言重写与后世生命"
    order: [file.name, dimension, sequence, history_position]
  - type: table
    name: QC2 组件、证据与阅读
    filters:
      and:
        - structure_type_zh == "QC2 组件、证据与阅读"
    order: [file.name, dimension, sequence, history_position]
