filters:
  and:
    - topic_id == "WL-TOPIC-QH1-2-FREEDOM-CHOICE"
formulas:
  type_zh: type.replace("literature_topic_structure", "核心结构").replace("literature_topic_section", "核心问题")
  dimension_zh: if(dimension, dimension.replace("core_problem", "核心问题").replace("definition", "定义与边界").replace("experience_mechanism", "约束、动机与行动机制").replace("comparison", "跨轴比较").replace("reading_route", "阅读路线"), "")
properties:
  file.name:
    displayName: 知识节点
  formula.type_zh:
    displayName: 类型
  formula.dimension_zh:
    displayName: 维度
  note.sequence:
    displayName: 顺序
  note.type:
    displayName: 类型代码
  note.dimension:
    displayName: 维度代码
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部知识节点
    groupBy:
      property: formula.type_zh
      direction: ASC
    order:
      - file.name
      - formula.dimension_zh
      - sequence
      - id
  - type: table
    name: 核心结构
    filters:
      and:
        - type == "literature_topic_structure"
    order:
      - file.name
      - formula.dimension_zh
      - sequence
  - type: table
    name: 核心问题
    filters:
      and:
        - type == "literature_topic_section"
    order:
      - sequence
      - file.name
      - id