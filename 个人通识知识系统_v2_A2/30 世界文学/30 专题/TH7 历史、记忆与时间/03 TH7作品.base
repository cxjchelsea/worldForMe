filters:
  and:
    - file.path.startsWith("个人通识知识系统_v2_A2/30 世界文学/40 作品/")
    - topics.contains("WL-TOPIC-Q10-MEMORY")
views:
  - type: table
    name: 核心作品
    filters:
      and:
        - history_memory_time_priority == "★"
    order:
      - file.link
      - history_memory_time_role
      - history_memory_time_problems
      - history_memory_time_note
  - type: table
    name: 全部作品
    order:
      - file.link
      - history_memory_time_priority
      - history_memory_time_role
      - history_memory_time_problems
      - history_memory_time_note
      - memory_priority
      - memory_dimensions
