filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-Q10-MEMORY")
properties:
  file.name: {displayName: 作品}
  note.author: {displayName: 作者}
  note.read_status: {displayName: 阅读状态}
  note.history_memory_time_priority: {displayName: TH7优先级}
  note.history_memory_time_role: {displayName: TH7角色}
  note.history_memory_time_problems: {displayName: TH7核心问题}
  note.history_memory_time_note: {displayName: TH7价值}
  note.memory_priority: {displayName: 旧记忆层优先级}
  note.memory_dimensions: {displayName: 旧记忆维度}
  note.axis_t: {displayName: 时间}
  note.axis_r: {displayName: 地域}
  note.axis_m: {displayName: 思潮}
  note.axis_g: {displayName: 体裁}
  note.axis_th: {displayName: 主题}
  note.id: {displayName: 编号}
views:
  - type: table
    name: 核心 ★
    filters: {and: [history_memory_time_priority == "★"]}
    order: [file.name, author, read_status, history_memory_time_role, history_memory_time_problems, history_memory_time_note, axis_t, axis_r, axis_m, axis_g, axis_th]
  - type: table
    name: 重点 ◆
    filters: {and: [history_memory_time_priority == "◆"]}
    order: [file.name, author, read_status, history_memory_time_role, history_memory_time_problems, history_memory_time_note]
  - type: table
    name: 扩展 △
    filters: {and: [history_memory_time_priority == "△"]}
    order: [file.name, author, read_status, history_memory_time_role, history_memory_time_problems, history_memory_time_note]
  - type: table
    name: 已读
    filters: {or: [read_status == "已读", read_status == "重读"]}
    order: [file.name, author, history_memory_time_priority, history_memory_time_role, history_memory_time_problems, memory_priority, axis_t, axis_r, axis_m, axis_g]
  - type: table
    name: 未读
    filters: {and: [read_status == "未读"]}
    order: [file.name, author, history_memory_time_priority, history_memory_time_role, history_memory_time_problems, memory_priority, axis_t, axis_r, axis_m, axis_g]
  - type: table
    name: 全部作品
    order: [file.name, author, history_memory_time_priority, history_memory_time_role, read_status, history_memory_time_problems, history_memory_time_note, memory_priority, memory_dimensions, axis_t, axis_r, axis_m, axis_g, axis_th, id]
