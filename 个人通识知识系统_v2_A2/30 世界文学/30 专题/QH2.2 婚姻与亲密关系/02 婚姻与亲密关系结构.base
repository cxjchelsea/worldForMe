filters:
  and:
    - type == "literature_topic_structure"
    - topic_id == "WL-TOPIC-QH2-2-MARRIAGE-INTIMACY"
properties:
  file.name:
    displayName: "结构页"
  note.dimension:
    displayName: "维度"
  note.sequence:
    displayName: "序号"
views:
  - type: table
    name: 全部结构
    order:
      - file.name
      - dimension
      - sequence
