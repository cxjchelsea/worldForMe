filters:
  and:
    - type == "work"
    - topics.contains("WL-TOPIC-G45-MYSTERY")
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.topic_links:
    displayName: 专题
  note.topics:
    displayName: 专题编号
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 体裁 / 形式
  note.axis_q:
    displayName: Q 类型 / 主题
  note.id:
    displayName: 编号
  note.mystery_priority:
    displayName: 专题优先级
  note.mystery_layer:
    displayName: 阅读与传播层
  note.mystery_history_cluster:
    displayName: 历史位置
  note.verification_status:
    displayName: 校验状态
  note.mystery_history:
    displayName: 细部历史
  note.mystery_history_detail:
    displayName: 历史细分
  note.mystery_technique:
    displayName: 谜题技法
  note.mystery_mode:
    displayName: 犯罪模式
views:
  - type: table
    name: 全部作品
    order:
      - file.name
      - author
      - read_status
      - mystery_priority
      - mystery_layer
      - mystery_history_cluster
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - topic_links
      - id
  - type: table
    name: 核心骨架 ★
    filters:
      and:
        - mystery_priority == "★"
    order:
      - file.name
      - author
      - read_status
      - mystery_layer
      - mystery_history_cluster
      - axis_t
      - axis_r
      - id
  - type: table
    name: 骨架未读
    filters:
      and:
        - mystery_priority == "★"
        - read_status == "未读"
    order:
      - file.name
      - author
      - mystery_layer
      - mystery_history_cluster
      - axis_t
      - axis_r
      - id
  - type: table
    name: 系统扩展 ◆
    filters:
      and:
        - mystery_priority == "◆"
    order:
      - file.name
      - author
      - read_status
      - mystery_layer
      - mystery_history_cluster
      - axis_t
      - axis_r
      - id
  - type: table
    name: 深挖候选 ○
    filters:
      and:
        - mystery_priority == "○"
    order:
      - file.name
      - author
      - read_status
      - mystery_layer
      - mystery_history_cluster
      - axis_t
      - axis_r
      - id
  - type: table
    name: 文学史骨架
    filters:
      and:
        - mystery_layer.contains("文学史骨架")
    order:
      - file.name
      - author
      - read_status
      - mystery_priority
      - mystery_history_cluster
      - axis_t
      - axis_r
      - id
  - type: table
    name: 类型重要
    filters:
      and:
        - mystery_layer.contains("类型重要")
    order:
      - file.name
      - author
      - read_status
      - mystery_priority
      - mystery_mode
      - mystery_technique
      - axis_r
      - id
  - type: table
    name: 大众入口
    filters:
      and:
        - mystery_layer.contains("大众入口")
    order:
      - file.name
      - author
      - read_status
      - mystery_priority
      - mystery_history_cluster
      - axis_r
      - id
  - type: table
    name: 当代代表
    filters:
      and:
        - mystery_layer.contains("当代代表")
    order:
      - file.name
      - author
      - read_status
      - mystery_priority
      - mystery_history_cluster
      - axis_r
      - id
  - type: table
    name: 按历史
    groupBy:
      property: mystery_history_cluster
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - mystery_priority
      - mystery_layer
      - axis_t
      - axis_r
      - id
  - type: table
    name: 按地域
    groupBy:
      property: axis_r
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - mystery_priority
      - mystery_layer
      - mystery_history_cluster
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - mystery_priority
      - mystery_layer
      - mystery_history_cluster
      - axis_r
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - mystery_priority
      - mystery_layer
      - mystery_history_cluster
      - axis_r
      - id
