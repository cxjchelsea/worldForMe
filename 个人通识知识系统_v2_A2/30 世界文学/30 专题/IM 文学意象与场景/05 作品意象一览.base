filters:
  and:
    - type == "work"
    - file.folder == "个人通识知识系统_v2_A2/30 世界文学/40 作品"
    - imagery_count > 0
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.imagery_count:
    displayName: 意象数
  note.im_dominant:
    displayName: 主导
  note.im_core:
    displayName: 核心
  note.im_significant:
    displayName: 显著
  note.read_status:
    displayName: 阅读状态
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部作品意象
    order:
      - file.name
      - author
      - imagery_count
      - im_dominant
      - im_core
      - im_significant
      - read_status
      - id
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - imagery_count
      - im_dominant
      - im_core
      - im_significant
      - id
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 按意象数
    order:
      - file.name
      - author
      - imagery_count
      - im_dominant
      - im_core
      - im_significant
      - read_status
      - id
    sort:
      - property: imagery_count
        direction: DESC
      - property: file.name
        direction: ASC
