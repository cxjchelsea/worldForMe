{"nodes":[{"id":"root","type":"file","x":760,"y":0,"width":520,"height":100,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/T5 二战后多极文学/00 二战后多极文学.md"},{"id":"question","type":"text","x":0,"y":0,"width":500,"height":120,"text":"核心问题\n1945以后，世界文学为什么不再能由单一欧洲中心解释？\n同一组战后压力又怎样在不同地区长成不同文学形式？"},{"id":"history","type":"file","x":0,"y":220,"width":430,"height":85,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/T5 二战后多极文学/10 结构/02 四阶段时间演进.md"},{"id":"system","type":"file","x":500,"y":220,"width":430,"height":85,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/T5 二战后多极文学/10 结构/03 战后世界体系与多中心结构.md"},{"id":"compare","type":"file","x":1000,"y":220,"width":430,"height":85,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/T5 二战后多极文学/10 结构/06 跨区域比较.md"},{"id":"fields","type":"text","x":1500,"y":220,"width":430,"height":100,"text":"六个多极文学场域\n欧洲 / 北美 / 拉美 / 非洲-加勒比\n南亚-中东 / 东亚"},{"id":"mechanisms","type":"text","x":500,"y":410,"width":520,"height":120,"text":"五条战后机制\n去中心化\n十五条问题横轴\n冷战与审查\n去殖民与民族国家\n翻译、奖项与世界文学市场"},{"id":"stages","type":"text","x":0,"y":410,"width":430,"height":130,"text":"四阶段\n1945—1955 废墟与重新开始\n1955—1965 多中心化\n1965—1975 文学爆炸与全球分叉\n1975—1980 后现代成熟"},{"id":"fielddb","type":"file","x":1120,"y":420,"width":430,"height":85,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/T5 二战后多极文学/02 二战后多极文学结构.base"},{"id":"works","type":"file","x":700,"y":650,"width":430,"height":85,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/T5 二战后多极文学/03 二战后多极作品.base"},{"id":"reading","type":"file","x":1180,"y":650,"width":430,"height":85,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/T5 二战后多极文学/10 结构/05 阅读路线.md"},{"id":"previous","type":"file","x":260,"y":840,"width":430,"height":85,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/T4 全球现代主义时代/00 全球现代主义时代.md"},{"id":"next","type":"file","x":1410,"y":840,"width":430,"height":85,"file":"个人通识知识系统_v2_A2/30 世界文学/30 专题/T6 当代全球文学/00 当代全球文学.md"}],"edges":[{"id":"e1","fromNode":"question","toNode":"root"},{"id":"e2","fromNode":"root","toNode":"history"},{"id":"e3","fromNode":"root","toNode":"system"},{"id":"e4","fromNode":"root","toNode":"compare"},