filters:
  and:
    - topic_id == "WL-TOPIC-T5-POSTWAR"
properties:
  file.name:
    displayName: 节点
  note.type:
    displayName: 类型
  note.dimension:
    displayName: 维度
  note.sequence:
    displayName: 顺序
  note.parent:
    displayName: 父节点
  note.postwar_stage:
    displayName: 历史位置
  note.importance:
    displayName: 重要度
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部知识节点
    order:
      - file.name
      - type
      - dimension
      - sequence
      - parent
      - postwar_stage
      - importance
      - id
  - type: table
    name: 核心结构
    filters:
      and:
        - type == "literature_topic_structure"
    order:
      - file.name
      - dimension
      - sequence
      - importance
      - id
  - type: table
    name: 四阶段时间纵轴
    filters:
      and:
        - type == "literature_topic_section"
        - dimension != "literary_field"
    order:
      - file.name
      - postwar_stage
      - sequence
      - id
  - type: table
    name: 多极文学场域
    filters:
      and:
        - type == "literature_topic_section"
        - dimension == "literary_field"
    order:
      - file.name
      - sequence
      - importance
      - id
  - type: table
    name: 战后机制
    filters:
      and:
        - type == "literature_topic_mechanism"
    order:
      - file.name
      - dimension
      - sequence
      - importance
      - id
