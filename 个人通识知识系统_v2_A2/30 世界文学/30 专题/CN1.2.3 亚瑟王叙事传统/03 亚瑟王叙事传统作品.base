filters:
  and:
    - type == "work"
    - file.folder == "个人通识知识系统_v2_A2/30 世界文学/40 作品"
    - or:
        - qc123_priority == "★"
        - qc123_priority == "◆"
        - qc123_priority == "△"
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.qc123_priority:
    displayName: 优先级
  note.qc123_stage:
    displayName: 文本阶段
  note.qc123_text_role:
    displayName: 文本角色
  note.qc123_role:
    displayName: 专题角色
  note.qc123_figure_focus:
    displayName: 人物焦点
  note.qc123_subtraditions:
    displayName: 子传统
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 类型
  note.axis_q:
    displayName: 主题
  note.id:
    displayName: 编号
  note.verification_status:
    displayName: 校验状态
views:
  - type: table
    name: 全部 CN1.2.3 作品
    order:
      - file.name
      - author
      - read_status
      - qc123_priority
      - qc123_stage
      - qc123_text_role
      - qc123_role
      - qc123_figure_focus
      - qc123_subtraditions
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
      - verification_status
  - type: table
    name: 核心 ★
    filters:
      and:
        - qc123_priority == "★"
    order:
      - file.name
      - author
      - qc123_stage
      - qc123_text_role
      - qc123_role
      - qc123_figure_focus
  - type: table
    name: 重点 ◆
    filters:
      and:
        - qc123_priority == "◆"
    order:
      - file.name
      - author
      - qc123_stage
      - qc123_text_role
      - qc123_role
      - qc123_figure_focus
  - type: table
    name: 扩展 △
    filters:
      and:
        - qc123_priority == "△"
    order:
      - file.name
      - author
      - qc123_stage
      - qc123_text_role
      - qc123_role
  - type: table
    name: 按文本阶段
    groupBy:
      property: qc123_stage
      direction: ASC
    order:
      - file.name
      - qc123_priority
      - qc123_text_role
      - qc123_role
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - qc123_priority
      - qc123_stage
      - qc123_text_role
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - qc123_priority
      - qc123_stage
      - qc123_text_role
  - type: table
    name: 待校验
    filters:
      and:
        - verification_status != "自动通过"
        - verification_status != "手工核验"
    order:
      - file.name
      - qc123_priority
      - qc123_stage
      - qc123_text_role
      - verification_status
