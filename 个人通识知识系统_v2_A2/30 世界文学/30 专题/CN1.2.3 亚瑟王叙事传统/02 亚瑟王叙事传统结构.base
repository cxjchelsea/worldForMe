filters:
  and:
    - topic_id == "WL-TOPIC-CN123"
    - structure_type_zh != null
formulas:
  dimension_zh: if(dimension, dimension.replace("central_figure_boundary", "中心人物与传统边界").replace("early_arthur_chronicle", "早期亚瑟与编年史传统").replace("textual_witness_registry", "关键文本与循环见证清单").replace("textual_expansion_cycle", "从宫廷传奇到散文循环").replace("figure_network_subtraditions", "人物网络与子传统边界").replace("compilation_reinvention", "马洛礼与后世再发明").replace("qc2_evidence_reading", "CN2 映射与阅读路线"), "")
properties:
  file.name:
    displayName: 节点
  note.structure_type_zh:
    displayName: 所属模块
  formula.dimension_zh:
    displayName: 维度
  note.sequence:
    displayName: 顺序
  note.history_position:
    displayName: 节点作用
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部知识节点
    groupBy:
      property: structure_type_zh
      direction: ASC
    order:
      - file.name
      - structure_type_zh
      - formula.dimension_zh
      - sequence
      - history_position
      - id
  - type: table
    name: 中心人物、边界与亚瑟王廷框架
    filters:
      and:
        - structure_type_zh == "中心人物、边界与亚瑟王廷框架"
    order:
      - file.name
      - formula.dimension_zh
      - sequence
      - history_position
      - id
  - type: table
    name: 早期亚瑟与编年史定型
    filters:
      and:
        - structure_type_zh == "早期亚瑟与编年史定型"
    order:
      - file.name
      - formula.dimension_zh
      - sequence
      - history_position
      - id
  - type: table
    name: 多语言扩张、文本阶段与循环化
    filters:
      and:
        - structure_type_zh == "多语言扩张、文本阶段与循环化"
    order:
      - file.name
      - formula.dimension_zh
      - sequence
      - history_position
      - id
  - type: table
    name: 人物网络、子传统与升格边界
    filters:
      and:
        - structure_type_zh == "人物网络、子传统与升格边界"
    order:
      - file.name
      - formula.dimension_zh
      - sequence
      - history_position
      - id
  - type: table
    name: 集成文本、后世再发明与现代生命
    filters:
      and:
        - structure_type_zh == "集成文本、后世再发明与现代生命"
    order:
      - file.name
      - formula.dimension_zh
      - sequence
      - history_position
      - id
  - type: table
    name: CN2 组件、证据与阅读
    filters:
      and:
        - structure_type_zh == "CN2 组件、证据与阅读"
    order:
      - file.name
      - formula.dimension_zh
      - sequence
      - history_position
      - id
