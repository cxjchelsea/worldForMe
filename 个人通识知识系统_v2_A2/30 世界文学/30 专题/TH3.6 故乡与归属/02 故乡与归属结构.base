filters:
  or:
    - topic_id == "WL-TOPIC-TH3-6-HOME-BELONGING"
    - file.path.startsWith("个人通识知识系统_v2_A2/30 世界文学/30 专题/TH3.6 故乡与归属/10 结构/")
    - file.path.startsWith("个人通识知识系统_v2_A2/30 世界文学/30 专题/TH3.6 故乡与归属/11 核心问题/")
formulas:
  type_zh: if(type == "literature_topic_structure", "核心结构", if(type == "literature_topic_problem" || type == "literature_topic_section", "核心问题", "兼容节点"))
  dimension_zh: if(dimension, dimension.replace("core_problem", "核心问题").replace("definition", "定义与边界").replace("mechanism", "作用机制").replace("comparison", "跨轴比较").replace("reading_route", "阅读路线").replace("review", "终审与校准"), "")
properties:
  file.name: {displayName: 节点}
  formula.type_zh: {displayName: 类型}
  formula.dimension_zh: {displayName: 维度}
  note.sequence: {displayName: 顺序}
  note.parent: {displayName: 父节点}
  note.problem_code: {displayName: 问题编号}
  note.status: {displayName: 状态}
  note.id: {displayName: 编号}
views:
  - type: table
    name: 全部知识节点
    order: [file.name, formula.type_zh, formula.dimension_zh, problem_code, sequence, parent, status, id]
  - type: table
    name: 核心结构
    filters: {and: [file.path.startsWith("个人通识知识系统_v2_A2/30 世界文学/30 专题/TH3.6 故乡与归属/10 结构/")]}
    order: [file.name, formula.dimension_zh, sequence, id]
  - type: table
    name: 核心问题
    filters: {and: [file.path.startsWith("个人通识知识系统_v2_A2/30 世界文学/30 专题/TH3.6 故乡与归属/11 核心问题/")]}
    order: [problem_code, file.name, status, id]
