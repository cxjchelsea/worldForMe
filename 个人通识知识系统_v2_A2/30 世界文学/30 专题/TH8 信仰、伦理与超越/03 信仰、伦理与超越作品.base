filters:
  and:
    - file.path.startsWith("个人通识知识系统_v2_A2/30 世界文学/40 作品/")
    - topics.contains("WL-TOPIC-TH8-FAITH-ETHICS-TRANSCENDENCE")
views:
  - type: table
    name: 核心作品
    filters:
      and:
        - faith_ethics_priority == "★"
    order:
      - file.link
      - faith_ethics_role
      - faith_ethics_problems
      - faith_ethics_note
  - type: table
    name: 全部作品
    order:
      - file.link
      - faith_ethics_priority
      - faith_ethics_role
      - faith_ethics_problems
      - faith_ethics_note
