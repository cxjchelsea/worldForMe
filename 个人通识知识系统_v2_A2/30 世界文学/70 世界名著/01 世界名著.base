filters:
  and:
    - type == "work"
    - canon_level != null
formulas:
  level_zh: if(canon_level, canon_level.replace("Extended", "扩展").replace("Major", "主要").replace("Core", "核心"), "")
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.topic_links:
    displayName: 专题
  note.topics:
    displayName: 专题编号
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 类型
  note.axis_q:
    displayName: 主题
  note.id:
    displayName: 编号
  formula.level_zh:
    displayName: 层级
  note.title:
    displayName: 标准书名
  note.aliases:
    displayName: 其他题名
  note.verification_status:
    displayName: 校验状态
  note.canon_id:
    displayName: 名著编号
views:
  - type: table
    name: 按层级
    groupBy:
      property: formula.level_zh
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按时间
    groupBy:
      property: axis_t
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按地域
    groupBy:
      property: axis_r
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按思潮
    groupBy:
      property: axis_m
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按类型
    groupBy:
      property: axis_g
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 按主题
    groupBy:
      property: axis_q
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    groupBy:
      property: formula.level_zh
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    groupBy:
      property: formula.level_zh
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_q
      - id
