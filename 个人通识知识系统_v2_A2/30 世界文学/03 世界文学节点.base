filters:
  and:
    - type == "literature_node"
    - id.startsWith("WL-")
formulas:
  axis_zh: if(axis, axis.replace("T", "T 时间").replace("R", "R 地域").replace("M", "M 思潮").replace("G", "G 类型").replace("Q", "Q 主题"), "")
properties:
  file.name:
    displayName: 节点
  formula.axis_zh:
    displayName: 轴
  note.axis:
    displayName: 轴
  note.topic_map:
    displayName: 专题地图
views:
  - type: table
    name: 全部节点
    groupBy:
      property: formula.axis_zh
      direction: ASC
    order:
      - file.name
      - formula.axis_zh
      - topic_map
    columnSize:
      file.name: 285
  - type: table
    name: 五轴一级节点
    filters:
      and:
        - level == 1
    groupBy:
      property: formula.axis_zh
      direction: ASC
    order:
      - file.name
      - formula.axis_zh
      - topic_map
  - type: table
    name: 尚未接入专题
    filters:
      and:
        - topic_map == null
    groupBy:
      property: formula.axis_zh
      direction: ASC
    order:
      - file.name
      - formula.axis_zh
      - topic_map
