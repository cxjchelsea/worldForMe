filters:
  and:
    - type == "work"
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.topic_links:
    displayName: 专题
  note.topics:
    displayName: 专题编号
  note.axis_t:
    displayName: T 时间
  note.axis_r:
    displayName: R 地域
  note.axis_m:
    displayName: M 思潮 / 美学
  note.axis_g:
    displayName: G 体裁
  note.axis_th:
    displayName: TH 主题
  note.axis_ty:
    displayName: TY 类型 / 叙事机制
  note.axis_q:
    displayName: Q legacy（迁移期）
  note.qx:
    displayName: IM 意象
  note.cultural_narrative_relations:
    displayName: CN 关系
  note.id:
    displayName: 编号
  note.title:
    displayName: 标准书名
  note.aliases:
    displayName: 其他题名
  note.verification_status:
    displayName: 校验状态
views:
  - type: table
    name: 全部作品
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_th
      - axis_ty
      - qx
      - cultural_narrative_relations
      - axis_q
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - read_status
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_th
      - axis_ty
      - axis_q
      - id
  - type: table
    name: 在读
    filters:
      and:
        - read_status == "在读"
    order:
      - file.name
      - author
      - read_status
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_th
      - axis_ty
      - axis_q
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_th
      - axis_ty
      - qx
      - cultural_narrative_relations
      - axis_q
      - id
  - type: table
    name: 按时间
    groupBy:
      property: axis_t
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - axis_t
      - axis_th
      - axis_ty
      - id
  - type: table
    name: 按地域
    groupBy:
      property: axis_r
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - axis_r
      - axis_th
      - axis_ty
      - id
  - type: table
    name: 按思潮
    groupBy:
      property: axis_m
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - axis_m
      - axis_th
      - axis_ty
      - id
  - type: table
    name: 按体裁
    groupBy:
      property: axis_g
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - axis_g
      - axis_th
      - axis_ty
      - id
  - type: table
    name: 按 TH 主题
    groupBy:
      property: axis_th
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - axis_th
      - axis_ty
      - axis_q
      - id
  - type: table
    name: 按 TY 类型
    groupBy:
      property: axis_ty
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - axis_ty
      - axis_th
      - axis_q
      - id
  - type: table
    name: Q legacy（迁移期）
    groupBy:
      property: axis_q
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - axis_q
      - axis_th
      - axis_ty
      - id
  - type: table
    name: IM / CN 网络关系
    order:
      - file.name
      - author
      - read_status
      - qx
      - cultural_narrative_relations
      - topic_links
      - id
  - type: table
    name: 按作者
    groupBy:
      property: author
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_th
      - axis_ty
      - id
  - type: table
    name: 需复核
    filters:
      and:
        - verification_status == "需复核"
    order:
      - file.name
      - author
      - read_status
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_th
      - axis_ty
      - axis_q
      - id
