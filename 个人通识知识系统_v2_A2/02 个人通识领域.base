filters:
  and:
    - type == "domain"
    - id.startsWith("PGK-D")
formulas:
  status_zh: if(exploration_status, exploration_status.replace("unexplored", "未探索").replace("interested", "有持续兴趣").replace("mapped", "已建立专题地图").replace("trial", "已试读"), "")
properties:
  file.name:
    displayName: 领域
  note.parent_name:
    displayName: 知识世界
  note.priority:
    displayName: 优先级
  formula.status_zh:
    displayName: 探索状态
  note.exploration_status:
    displayName: 探索状态
  note.child_map:
    displayName: 下一级地图
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部领域
    order:
      - file.name
      - parent_name
      - priority
      - formula.status_zh
      - child_map
      - id
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 247
  - type: table
    name: 按知识世界
    groupBy:
      property: parent_name
      direction: ASC
    order:
      - file.name
      - parent_name
      - priority
      - formula.status_zh
      - child_map
      - id
  - type: table
    name: 待继续探索
    filters:
      and:
        - exploration_status != "mapped"
        - or:
            - priority == "S"
            - priority == "A"
    order:
      - file.name
      - parent_name
      - priority
      - formula.status_zh
      - child_map
      - id
