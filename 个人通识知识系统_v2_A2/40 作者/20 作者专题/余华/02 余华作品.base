filters:
  and:
    - type == "work"
    - author == "余华"
properties:
  file.name:
    displayName: 作品
  title:
    displayName: 标准书名
  read_status:
    displayName: 阅读状态
  author_reading_priority:
    displayName: 追读优先级
  year:
    displayName: 首次出版年
  topics:
    displayName: 专题
  axis_t:
    displayName: T 时间
  axis_r:
    displayName: R 地域
  axis_m:
    displayName: M 思潮
  axis_g:
    displayName: G 类型
  axis_n:
    displayName: N 叙事
  axis_q:
    displayName: Q 主题
  id:
    displayName: 稳定 ID
views:
  - type: table
    name: 全部作品
    order:
      - file.name
      - read_status
      - author_reading_priority
      - year
      - topics
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - year
      - axis_t
      - axis_g
      - axis_q
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author_reading_priority
      - year
      - topics
      - id
  - type: table
    name: 追读计划
    filters:
      and:
        - or:
            - author_reading_priority == "下一本"
            - author_reading_priority == "核心"
            - author_reading_priority == "延伸"
    order:
      - file.name
      - read_status
      - author_reading_priority
      - year
      - id
