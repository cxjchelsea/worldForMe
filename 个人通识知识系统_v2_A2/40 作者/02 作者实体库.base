filters:
  and:
    - type == "author"
properties:
  file.name:
    displayName: 作者
  note.name:
    displayName: 标准姓名
  note.aliases:
    displayName: 别名
  note.birth_year:
    displayName: 生年
  note.death_year:
    displayName: 卒年
  note.regions:
    displayName: 地域
  note.movements:
    displayName: 思潮
  note.author_status:
    displayName: 追读状态
  note.reading_goal:
    displayName: 追读目标
  note.author_map_status:
    displayName: 专题状态
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部作者实体
    order:
      - file.name
      - aliases
      - birth_year
      - death_year
      - regions
      - movements
      - author_status
      - reading_goal
      - author_map_status
      - id
  - type: table
    name: 正在追读
    filters:
      and:
        - author_status == "追读"
    order:
      - file.name
      - aliases
      - birth_year
      - death_year
      - regions
      - movements
      - author_status
      - reading_goal
      - author_map_status
      - id
  - type: table
    name: 已建作者专题
    filters:
      and:
        - author_map_status == "已建立"
    order:
      - file.name
      - aliases
      - birth_year
      - death_year
      - regions
      - movements
      - author_status
      - reading_goal
      - author_map_status
      - id
