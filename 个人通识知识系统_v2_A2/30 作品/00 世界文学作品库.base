filters:
  and:
    - type == "work"
properties:
  file.name:
    displayName: 作品
  title:
    displayName: 标准书名
  aliases:
    displayName: 其他题名
  author:
    displayName: 作者
  year:
    displayName: 首次出版年
  topics:
    displayName: 专题
  read_status:
    displayName: 阅读状态
  axis_t:
    displayName: T 时间
  axis_r:
    displayName: R 地域
  axis_m:
    displayName: M 思潮
  axis_g:
    displayName: G 类型
  axis_n:
    displayName: N 叙事
  axis_q:
    displayName: Q 主题
  verification_status:
    displayName: 校验状态
  id:
    displayName: 稳定 ID
views:
  - type: table
    name: 全部作品
    order:
      - file.name
      - author
      - topics
      - read_status
      - id
    columnSize:
      note.topics: 503
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - topics
      - id
  - type: table
    name: 在读
    filters:
      and:
        - read_status == "在读"
    order:
      - file.name
      - author
      - topics
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    order:
      - file.name
      - author
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 已读按时间
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    groupBy:
      property: axis_t
      direction: ASC
    order:
      - file.name
      - author
      - axis_r
      - axis_g
      - axis_q
  - type: table
    name: 已读按地域
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    groupBy:
      property: axis_r
      direction: ASC
    order:
      - file.name
      - author
      - axis_t
      - axis_g
      - axis_q
  - type: table
    name: 需复核
    filters:
      and:
        - verification_status == "需复核"
    order:
      - file.name
      - author
      - aliases
      - verification_status
      - id
