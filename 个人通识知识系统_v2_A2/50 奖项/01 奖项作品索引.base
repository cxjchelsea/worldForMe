filters:
  and:
    - type == "work"
    - or:
        - awards.contains("WL-AWARD-BOOKER")
        - awards.contains("WL-AWARD-PULITZER-FICTION")
        - awards.contains("WL-AWARD-MAODUN")
        - awards.contains("WL-AWARD-HUGO")
        - awards.contains("WL-AWARD-NEBULA")
        - awards.contains("WL-AWARD-EDGAR")
properties:
  file.name:
    displayName: 作品
  note.author:
    displayName: 作者
  note.read_status:
    displayName: 阅读状态
  note.topic_links:
    displayName: 专题
  note.topics:
    displayName: 专题编号
  note.axis_t:
    displayName: 时间
  note.axis_r:
    displayName: 地域
  note.axis_m:
    displayName: 思潮
  note.axis_g:
    displayName: 类型
  note.axis_n:
    displayName: 叙事
  note.axis_q:
    displayName: 主题
  note.id:
    displayName: 编号
  note.title:
    displayName: 标准书名
  note.awards:
    displayName: 奖项
views:
  - type: table
    name: 按奖项
    groupBy:
      property: awards
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
    sort:
      - property: axis_m
        direction: ASC
      - property: axis_r
        direction: DESC
      - property: axis_g
        direction: ASC
    columnSize:
      file.name: 94
      note.author: 74
      note.read_status: 113
      note.topic_links: 111
      note.axis_t: 212
      note.axis_r: 143
      note.axis_m: 215
      note.axis_g: 106
      note.axis_n: 304
      note.axis_q: 368
  - type: table
    name: 布克奖
    filters:
      and:
        - awards.contains("WL-AWARD-BOOKER")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 普利策小说奖
    filters:
      and:
        - awards.contains("WL-AWARD-PULITZER-FICTION")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 茅盾文学奖
    filters:
      and:
        - awards.contains("WL-AWARD-MAODUN")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 雨果奖
    filters:
      and:
        - awards.contains("WL-AWARD-HUGO")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 星云奖
    filters:
      and:
        - awards.contains("WL-AWARD-NEBULA")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 埃德加奖
    filters:
      and:
        - awards.contains("WL-AWARD-EDGAR")
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 已读获奖作品
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    groupBy:
      property: awards
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 未读获奖作品
    filters:
      and:
        - read_status == "未读"
    groupBy:
      property: awards
      direction: ASC
    order:
      - file.name
      - author
      - read_status
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
