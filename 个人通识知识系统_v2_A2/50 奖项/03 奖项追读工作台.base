filters:
  and:
    - type == "work"
    - or:
        - awards.contains("WL-AWARD-BOOKER")
        - awards.contains("WL-AWARD-PULITZER-FICTION")
        - awards.contains("WL-AWARD-MAODUN")
        - awards.contains("WL-AWARD-HUGO")
        - awards.contains("WL-AWARD-NEBULA")
        - awards.contains("WL-AWARD-EDGAR")
properties:
  file.name:
    displayName: "作品"
  note.author:
    displayName: "作者"
  note.year:
    displayName: "年份"
  note.read_status:
    displayName: "阅读状态"
  note.award_reading_priority:
    displayName: "追读优先级"
  note.topic_links:
    displayName: "专题"
  note.topics:
    displayName: "专题编号"
  note.axis_t:
    displayName: "时间"
  note.axis_r:
    displayName: "地域"
  note.axis_m:
    displayName: "思潮"
  note.axis_g:
    displayName: "类型"
  note.axis_n:
    displayName: "叙事"
  note.axis_q:
    displayName: "主题"
  note.id:
    displayName: "编号"
  note.title:
    displayName: "标准书名"
  note.awards:
    displayName: "奖项"
views:
  - type: table
    name: 追读总览
    groupBy:
      property: awards
      direction: ASC
    order:
      - file.name
      - author
      - year
      - read_status
      - award_reading_priority
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 下一本
    filters:
      and:
        - award_reading_priority == "下一本"
        - read_status == "未读"
    groupBy:
      property: awards
      direction: ASC
    order:
      - file.name
      - author
      - year
      - read_status
      - award_reading_priority
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 核心未读
    filters:
      and:
        - award_reading_priority == "核心"
        - read_status == "未读"
    groupBy:
      property: awards
      direction: ASC
    order:
      - file.name
      - author
      - year
      - read_status
      - award_reading_priority
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 延伸未读
    filters:
      and:
        - award_reading_priority == "延伸"
        - read_status == "未读"
    groupBy:
      property: awards
      direction: ASC
    order:
      - file.name
      - author
      - year
      - read_status
      - award_reading_priority
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 已读
    filters:
      and:
        - or:
            - read_status == "已读"
            - read_status == "重读"
    groupBy:
      property: awards
      direction: ASC
    order:
      - file.name
      - author
      - year
      - read_status
      - award_reading_priority
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    groupBy:
      property: awards
      direction: ASC
    order:
      - file.name
      - author
      - year
      - read_status
      - award_reading_priority
      - topic_links
      - axis_t
      - axis_r
      - axis_m
      - axis_g
      - axis_n
      - axis_q
      - id
