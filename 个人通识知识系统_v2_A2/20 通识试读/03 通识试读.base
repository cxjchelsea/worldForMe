filters:
  and:
    - type == "pgk_reading"
properties:
  file.name:
    displayName: 书名
  note.author:
    displayName: 作者
  note.domain_links:
    displayName: 领域
  note.domains:
    displayName: 领域编号
  note.read_status:
    displayName: 阅读状态
  note.id:
    displayName: 编号
views:
  - type: table
    name: 全部通识试读
    order:
      - file.name
      - author
      - domain_links
      - read_status
      - id
  - type: table
    name: 按领域
    groupBy:
      property: domain_links
      direction: ASC
    order:
      - file.name
      - author
      - domain_links
      - read_status
      - id
  - type: table
    name: 已读
    filters:
      and:
        - read_status == "已读"
    order:
      - file.name
      - author
      - domain_links
      - read_status
      - id
  - type: table
    name: 未读
    filters:
      and:
        - read_status == "未读"
    order:
      - file.name
      - author
      - domain_links
      - read_status
      - id
